module Exec
    intent =
        "The interpreter. A frame holds its code, program counter, locals,"
        "operand stack (a Vector written in place, sized by validation, and its"
        "stack pointer) and its function's branch targets. Structured control is"
        "resolved before anything runs (see resolve): block, loop and inner end"
        "are gone, if and else are plain jumps, and every branch indexes a"
        "target that says where it continues, how many values it carries and"
        "the stack height beneath them, known from validation; a target that"
        "continues at -1 returns. Calls push the caller onto"
        "an explicit list of frames, so nothing recurses on the host and"
        "return_call simply replaces the frame. Running is pure: a call to an"
        "imported function stops the machine with an Outcome.Host that holds"
        "everything needed to resume once the host has answered."
    exposes [Inst, Store, Frame, Machine, Outcome, Obj, Heap, Placed, Fn, MemState, Settled, Links, instantiate, prepare, prepareIn, blankStore, noLinks, gaddr, taddr, maddr, swapTo, settle, settlePart, invoke, resume, resumeThrow, tagId, exportFunc, Ready, writeMem, machineRoots, memState, putMemState, table, setTable]
    depends [Ast, Value, Num, Mem, Bin, Kompost, Arr, Simd, Types]
    effects []

record Label
    cont: Int
    arity: Int
    base: Int

record Frame
    code: Vector<Instr>
    pc: Int
    locals: Vector<Val>
    stack: Vector<Val>
    sp: Int
    targets: Vector<Label>
    arity: Int
    depth: Int

record Store
    globals: Vector<Val>
    heap: Heap
    mem: Map<Int, Vector<Int>>
    pages: Int
    maxPages: Int
    memAt: Int
    others: Map<Int, MemState>
    tables: Vector<Vector<Val>>
    elems: Vector<Vector<Val>>
    datas: Vector<Vector<Int>>
    gcAt: Int
    pinned: List<Val>
    steps: Int
    mods: Map<Int, Module>

record MemState
    mem: Map<Int, Vector<Int>>
    pages: Int
    maxPages: Int

record Fn
    code: Vector<Instr>
    targets: Vector<Label>
    defaults: Vector<Val>
    params: Int
    results: Int
    imported: Bool
    mod: String
    name: String
    ty: Int
    cap: Int

record Inst
    m: Module
    fns: Vector<Fn>
    base: Int
    tags: Vector<Int>
    ga: Vector<Int>
    ta: Vector<Int>
    ma: Vector<Int>
    ea: Vector<Int>
    da: Vector<Int>
    flat: Bool

record Machine
    frame: Frame
    calls: List<Frame>
    store: Store

type Outcome
    Done(List<Val>, Store)
    Trap(String, Store)
    Host(Int, List<Val>, Bool, Machine)
    Thrown(Int, List<Val>, Store)

type Next
    Go(Frame, List<Frame>, Store)
    Out(Outcome)

record Ready
    x: Inst
    s: Store

// ---- small helpers ----

// ---- addresses ----

fn gaddr(x: Inst, k: Int) -> Int
    ? "The store address of global k: k itself in a flat instance (a lone module), else what its map says."
    match x.flat
        true -> k
        false -> Option.withDefault(Vector.get(x.ga, k), k)

fn taddr(x: Inst, t: Int) -> Int
    ? "The store address of table t."
    match x.flat
        true -> t
        false -> Option.withDefault(Vector.get(x.ta, t), t)

fn maddr(x: Inst, k: Int) -> Int
    ? "The store address of memory k."
    match x.flat
        true -> k
        false -> Option.withDefault(Vector.get(x.ma, k), k)

fn eaddr(x: Inst, e: Int) -> Int
    ? "The store address of element segment e."
    match x.flat
        true -> e
        false -> Option.withDefault(Vector.get(x.ea, e), e)

fn daddr(x: Inst, d: Int) -> Int
    ? "The store address of data segment d."
    match x.flat
        true -> d
        false -> Option.withDefault(Vector.get(x.da, d), d)

verify gaddr
    gaddr(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 3) => 3
    gaddr(Inst.update(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), ga = Vector.fromList([7]), flat = false), 0) => 7

verify taddr
    taddr(Inst.update(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), ta = Vector.fromList([4]), flat = false), 0) => 4

verify maddr
    maddr(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 1) => 1

verify eaddr
    eaddr(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 2) => 2

verify daddr
    daddr(Inst.update(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), da = Vector.fromList([9]), flat = false), 0) => 9

fn adv(f: Frame) -> Frame
    ? "The frame moved to its next instruction."
    Frame.update(f, pc = f.pc + 1)

fn push(f: Frame, v: Val) -> Frame
    ? "The frame with v pushed, moved on."
    adv(pushOnly(f, v))

fn pushOnly(f: Frame, v: Val) -> Frame
    ? "The frame with v written at the stack pointer; the stack is sized by validation, and grows if it ever is not."
    match f.sp < Vector.len(f.stack)
        true -> Frame.update(f, stack = vset(f.stack, f.sp, v), sp = f.sp + 1)
        false -> pushOnly(Frame.update(f, stack = grown(f.stack)), v)

fn grown(v: Vector<Val>) -> Vector<Val>
    ? "v with as many null slots again, at least eight."
    Vector.fromList(List.concat(List.fromVector(v), repeatVal(Val.Null, Int.max(Vector.len(v), 8), [])))

fn at(f: Frame, k: Int) -> Val
    ? "The value k places below the top of the stack."
    vget(f.stack, f.sp - 1 - k)

fn top(f: Frame, n: Int) -> List<Val>
    ? "The top n values, the top first; for the instructions that read several at once."
    topFrom(f, Int.min(n, f.sp) - 1, [])

fn topFrom(f: Frame, k: Int, acc: List<Val>) -> List<Val>
    ? "Values from k places below the top up to the top, the top first."
    match k < 0
        true -> acc
        false -> topFrom(f, k - 1, List.prepend(at(f, k), acc))

fn below(f: Frame, n: Int) -> Frame
    ? "The frame with n values taken off the stack."
    Frame.update(f, sp = f.sp - n)

fn put1(f: Frame, n: Int, v: Val) -> Frame
    ? "n values taken off, v pushed, moved on."
    push(below(f, n), v)

fn putN(f: Frame, n: Int) -> Frame
    ? "n values taken off, moved on."
    adv(below(f, n))

fn stackVals(f: Frame, n: Int) -> List<Val>
    ? "The values on the stack below the top n, the bottom first."
    List.take(List.fromVector(f.stack), f.sp - n)

fn newStack(cap: Int) -> Vector<Val>
    ? "An empty operand stack of the given capacity."
    Result.withDefault(Vector.new(Int.max(cap, 1), Val.Null), Vector.fromList([Val.Null]))

fn frame(code: Vector<Instr>, targets: Vector<Label>, locals: Vector<Val>, cap: Int, arity: Int) -> Frame
    ? "A fresh frame at the start of its code."
    Frame(code = code, pc = 0, locals = locals, stack = newStack(cap), sp = 0, targets = targets, arity = arity, depth = 0)

fn bare(locals: Vector<Val>, cap: Int, arity: Int) -> Frame
    ? "A frame with no code of its own."
    frame(Vector.fromList([]), Vector.fromList([]), locals, cap, arity)

verify top
    top(pushAll(bare(Vector.fromList([]), 2, 0), [Val.I32(1), Val.I32(2), Val.I32(3)]), 2) => [Val.I32(3), Val.I32(2)]

verify setArgs
    setArgs(Vector.fromList([Val.I32(0), Val.I32(0)]), pushAll(bare(Vector.fromList([]), 4, 0), [Val.I32(1), Val.I32(2)]), 2) => Vector.fromList([Val.I32(1), Val.I32(2)])

fn vset(v: Vector<Val>, k: Int, a: Val) -> Vector<Val>
    ? "v with slot k replaced; out of range leaves v as it is."
    Option.withDefault(Vector.set(v, k, a), v)

fn vget(v: Vector<Val>, k: Int) -> Val
    ? "Slot k of v, or null out of range."
    Option.withDefault(Vector.get(v, k), Val.Null)

fn hotLabel(f: Frame, d: Int) -> Option<Label>
    ? "Branch target d when it stays inside the function; None when it returns."
    match Vector.get(f.targets, d)
        Option.Some(l) -> inside(l)
        Option.None -> Option.None

fn inside(l: Label) -> Option<Label>
    ? "The target, unless it is the function's own, which returns."
    match l.cont >= 0
        true -> Option.Some(l)
        false -> Option.None

verify inside
    inside(Label(cont = -1, arity = 0, base = 0)) => Option.None
    inside(Label(cont = 3, arity = 0, base = 0)) => Option.Some(Label(cont = 3, arity = 0, base = 0))

verify hotLabel
    hotLabel(bare(Vector.fromList([]), 1, 0), 0) => Option.None

fn trapOr(r: Result<Frame, String>, x: Inst, calls: List<Frame>, s: Store) -> Next
    ? "Runs on with the frame, or traps."
    match r
        Result.Ok(f) -> go(x, f, calls, s)
        Result.Err(e) -> trap(e, s)

fn underflow(s: Store) -> Next
    ? "The trap for an operand stack too short, which validation rules out."
    trap("operand stack underflow", s)

fn isTrue(v: Val) -> Bool
    ? "Whether an i32 condition holds."
    Value.i32(v) != 0

// ---- the loop ----

fn run(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Outcome
    ? "Runs from the frame's program counter until the outermost function returns, a trap, or a call to the host."
    loop(x, f, calls, s, 0)

fn loop(x: Inst, f: Frame, calls: List<Frame>, s: Store, n: Int) -> Outcome
    ? "The interpreter loop, the only function that calls itself: the instructions that matter most are done here on the frame, so the loop never leaves; every other one goes through exec, which says how to go on. n counts the instructions run."
    match Vector.get(f.code, f.pc)
        Option.None -> match calls
            [c, ..rest] -> loop(x, returnTo(f, c), rest, s, n)
            [] -> stamp(Outcome.Done(List.reverse(top(f, f.arity)), s), n)
        Option.Some(i) -> match i
            Instr.LocalGet(k) -> loop(x, push(f, vget(f.locals, k)), calls, s, n + 1)
            Instr.GetGet(a, b) -> loop(x, getGet(f, a, b), calls, s, n + 2)
            Instr.SetGet(a, b) -> loop(x, setGet(f, a, b), calls, s, n + 2)
            Instr.GetConst(k, c) -> loop(x, adv(adv(pushOnly(pushOnly(f, vget(f.locals, k)), Val.I32(c)))), calls, s, n + 2)
            Instr.GetIsNull(k) -> loop(x, adv(push(f, boolVal(Value.isNull(vget(f.locals, k))))), calls, s, n + 2)
            Instr.GetField(k, t, fld, e) -> match vget(f.locals, k)
                Val.Ref(a) -> loop(x, adv(push(f, fieldOf(x, Kompost.get(s.heap, a), t, fld, e))), calls, s, n + 2)
                _ -> loop(x, push(f, vget(f.locals, k)), calls, s, n + 1)
            Instr.IsNullIfNot(t) -> loop(x, isNullIfNot(f, t), calls, s, n + 2)
            Instr.FieldTo(a, t, k, e, b) -> match vget(f.locals, a)
                Val.Ref(r) -> loop(x, setLocalBy(f, b, fieldOf(x, Kompost.get(s.heap, r), t, k, e), 3), calls, s, n + 3)
                _ -> loop(x, push(f, vget(f.locals, a)), calls, s, n + 1)
            Instr.Copy(a, b) -> loop(x, copyLocal(f, a, b), calls, s, n + 2)
            Instr.NullTo(b) -> loop(x, setLocalBy(f, b, Val.Null, 2), calls, s, n + 2)
            Instr.CastField(a, nl, h, t, k, e) -> loop(x, castField(x, s, f, a, nl, h, t, k, e), calls, s, n + 3)
            Instr.GetTestIfNot(a, nl, h, t) -> loop(x, Frame.update(f, pc = pickPc(matches(x, s, vget(f.locals, a), nl, h), f.pc + 3, t)), calls, s, n + 3)
            Instr.GetIsNullIfNot(a, t) -> loop(x, Frame.update(f, pc = pickPc(Value.isNull(vget(f.locals, a)), f.pc + 3, t)), calls, s, n + 3)
            Instr.TestIfNot(nl, h, t) -> loop(x, testIfNot(x, s, f, nl, h, t), calls, s, n + 2)
            Instr.Op2(op, a, b, k, out, oa, sk) -> loop(x, op2(f, op, a, b, k, out, oa, sk), calls, s, n + sk)
            Instr.JumpIf(t) -> loop(x, jumpIf(f, t), calls, s, n + 1)
            Instr.ArrayGetLL(a, b, t, e) -> match arrayGetHot(x, s, vget(f.locals, a), vget(f.locals, b), t, e)
                Option.Some(v) -> loop(x, pushBy(f, v, 3), calls, s, n + 3)
                Option.None -> loop(x, push(f, vget(f.locals, a)), calls, s, n + 1)
            Instr.NullTo2(a, b) -> loop(x, nullTo2(f, a, b), calls, s, n + 4)
            Instr.ConstTo(b, k, wide) -> loop(x, setLocalBy(f, b, constVal(k, wide), 2), calls, s, n + 2)
            Instr.GetBrOnNull(a, t) -> loop(x, getBrOnNull(f, a, t), calls, s, n + 2)
            Instr.BrOnNull(d) -> match hotLabel(f, d)
                Option.Some(l) -> loop(x, brOnNullDo(f, l), calls, s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.RefTest(nl, h) -> loop(x, put1(f, 1, boolVal(matches(x, s, at(f, 0), nl, h))), calls, s, n + 1)
            Instr.RefCast(nl, h) -> match matches(x, s, at(f, 0), nl, h)
                true -> loop(x, adv(f), calls, s, n + 1)
                false -> stamp(Outcome.Trap("cast failure", s), n + 1)
            Instr.I32Const(c) -> loop(x, push(f, Val.I32(c)), calls, s, n + 1)
            Instr.I64Const(c) -> loop(x, push(f, Val.I64(c)), calls, s, n + 1)
            Instr.LocalSet(k) -> loop(x, Frame.update(f, pc = f.pc + 1, sp = f.sp - 1, locals = vset(f.locals, k, at(f, 0))), calls, s, n + 1)
            Instr.LocalTee(k) -> loop(x, Frame.update(f, pc = f.pc + 1, locals = vset(f.locals, k, at(f, 0))), calls, s, n + 1)
            Instr.Drop -> loop(x, putN(f, 1), calls, s, n + 1)
            Instr.GlobalGet(k) -> loop(x, push(f, vget(s.globals, gaddr(x, k))), calls, s, n + 1)
            Instr.RefNull(_) -> loop(x, push(f, Val.Null), calls, s, n + 1)
            Instr.Call(fi) -> match calleeFrame(x, fi, f)
                Option.Some(g) -> loop(x, g, List.prepend(afterCall(x, fi, f), calls), s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.ReturnCall(fi) -> match calleeFrame(x, fi, f)
                Option.Some(g) -> loop(x, Frame.update(g, depth = g.depth - 1), calls, s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.Return -> match calls
                [c, ..rest] -> loop(x, returnTo(f, c), rest, s, n + 1)
                [] -> stamp(Outcome.Done(List.reverse(top(f, f.arity)), s), n + 1)
            Instr.Bin(op) -> match binHotOk(op, at(f, 1), at(f, 0))
                true -> loop(x, binDo(op, f), calls, s, n + 1)
                false -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.BrIf(d) -> match hotLabel(f, d)
                Option.Some(l) -> loop(x, brIfDo(f, l), calls, s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.Br(d) -> match hotLabel(f, d)
                Option.Some(l) -> loop(x, jump(f, l), calls, s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.Jump(t) -> loop(x, Frame.update(f, pc = t), calls, s, n + 1)
            Instr.End -> match calls
                [c, ..rest] -> loop(x, returnTo(f, c), rest, s, n + 1)
                [] -> stamp(Outcome.Done(List.reverse(top(f, f.arity)), s), n + 1)
            Instr.IfNot(t) -> loop(x, ifNot(f, t), calls, s, n + 1)
            Instr.RefIsNull -> loop(x, put1(f, 1, boolVal(Value.isNull(at(f, 0)))), calls, s, n + 1)
            Instr.Un(op) -> match unHotOk(op, at(f, 0))
                true -> loop(x, put1(f, 1, Result.withDefault(Num.unary(op, at(f, 0)), Val.Null)), calls, s, n + 1)
                false -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.ArrayGet(t, e) -> match arrayGetHot(x, s, at(f, 1), at(f, 0), t, e)
                Option.Some(v) -> loop(x, put1(f, 2, v), calls, s, n + 1)
                Option.None -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.ArraySet(t) -> match arraySetOk(s, at(f, 2), at(f, 1))
                true -> loop(x, putN(f, 3), calls, arraySetDo(x, s, at(f, 2), at(f, 1), at(f, 0), t), n + 1)
                false -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            Instr.StructGet(t, k, e) -> match at(f, 0)
                Val.Ref(a) -> loop(x, put1(f, 1, fieldOf(x, Kompost.get(s.heap, a), t, k, e)), calls, s, n + 1)
                _ -> match exec(x, i, f, calls, s)
                    Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                    Next.Out(o) -> stamp(o, n + 1)
            _ -> match exec(x, i, f, calls, s)
                Next.Go(f2, c2, s2) -> loop(x, f2, c2, s2, n + 1)
                Next.Out(o) -> stamp(o, n + 1)

fn returnTo(f: Frame, c: Frame) -> Frame
    ? "The caller once the callee's results are copied onto its stack."
    copyResults(f, c, f.arity, 0)

fn copyResults(f: Frame, c: Frame, n: Int, k: Int) -> Frame
    ? "Pushes the top n values of f onto c from the k-th on, the lowest first."
    match k >= n
        true -> c
        false -> copyResults(f, pushOnly(c, vget(f.stack, f.sp - n + k)), n, k + 1)

verify copyResults
    top(copyResults(pushOnly(pushOnly(bare(Vector.fromList([]), 2, 2), Val.I32(1)), Val.I32(2)), bare(Vector.fromList([]), 2, 0), 2, 0), 2) => [Val.I32(2), Val.I32(1)]

fn pushAll(f: Frame, vs: List<Val>) -> Frame
    ? "The frame with vs pushed in order, the last on top; the program counter stays."
    match vs
        [] -> f
        [v, ..rest] -> pushAll(pushOnly(f, v), rest)

fn calleeFrame(x: Inst, fi: Int, f: Frame) -> Option<Frame>
    ? "The frame of a call to a local function, its arguments taken from f's stack; None for an import."
    match Vector.get(x.fns, fi)
        Option.Some(g) -> calleeOf(g, f)
        Option.None -> Option.None

fn calleeOf(g: Fn, f: Frame) -> Option<Frame>
    ? "The callee frame for a local function, one deeper than f; None for an import, and when the stack is as deep as it may get (the slow path then traps)."
    match Bool.or(g.imported, f.depth >= maxDepth())
        true -> Option.None
        false -> Option.Some(Frame.update(frame(g.code, g.targets, setArgs(g.defaults, f, g.params), g.cap, g.results), depth = f.depth + 1))

fn maxDepth() -> Int
    ? "How many calls deep the machine may go before it traps with call stack exhausted."
    200000

verify maxDepth
    maxDepth() => 200000

fn afterCall(x: Inst, fi: Int, f: Frame) -> Frame
    ? "The caller as it waits: moved past the call, its arguments gone."
    putN(f, paramCount(x, fi))

fn paramCount(x: Inst, fi: Int) -> Int
    ? "How many parameters function fi takes."
    match Vector.get(x.fns, fi)
        Option.Some(g) -> g.params
        Option.None -> 0

fn stamp(o: Outcome, n: Int) -> Outcome
    ? "The outcome with the instructions run added to the store's count."
    match o
        Outcome.Done(vs, s) -> Outcome.Done(vs, Store.update(s, steps = s.steps + n))
        Outcome.Host(fi, args, tail, mach) -> Outcome.Host(fi, args, tail, Machine.update(mach, store = Store.update(mach.store, steps = mach.store.steps + n)))
        Outcome.Trap(e, st) -> Outcome.Trap(e, Store.update(st, steps = st.steps + n))
        Outcome.Thrown(t, vs, s) -> Outcome.Thrown(t, vs, Store.update(s, steps = s.steps + n))

fn go(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "Go on running with this frame, these callers and this store."
    Next.Go(f, calls, s)

fn trap(e: String, s: Store) -> Next
    ? "Stop with a trap. The store goes with it: a trap stops the program but does not undo what it wrote before."
    Next.Out(Outcome.Trap(e, s))

verify trap
    trap("x", emptyStore(Ast.emptyModule())) => Next.Out(Outcome.Trap("x", emptyStore(Ast.emptyModule())))

fn getGet(f: Frame, a: Int, b: Int) -> Frame
    ? "local.get a then local.get b, as one step; both locals are read before the frame is handed on, so its stack stays unshared."
    va = vget(f.locals, a)
    vb = vget(f.locals, b)
    adv(adv(pushOnly(pushOnly(f, va), vb)))

verify getGet
    getGet(bare(Vector.fromList([Val.I32(1), Val.I32(2)]), 2, 0), 1, 0).sp => 2

fn setGet(f: Frame, a: Int, b: Int) -> Frame
    ? "local.set a then local.get b, as one step; b is read before a is written, so the locals stay unshared."
    v = getAfterSet(f, a, b)
    push(Frame.update(f, pc = f.pc + 1, sp = f.sp - 1, locals = vset(f.locals, a, at(f, 0))), v)

fn getAfterSet(f: Frame, a: Int, b: Int) -> Val
    ? "What local b holds once local a is set to the top of the stack."
    match a == b
        true -> at(f, 0)
        false -> vget(f.locals, b)

fn binHotOk(op: Int, a: Val, b: Val) -> Bool
    ? "Whether a binary operation is one the loop does itself: every integer operation that cannot trap (all but division and remainder), on two i32 or two i64."
    match a
        Val.I32(_) -> Bool.and(isI32(b), Bool.or(Bool.and(op >= 106, op <= 108), Bool.or(Bool.and(op >= 113, op <= 120), Bool.and(op >= 70, op <= 79))))
        Val.I64(_) -> Bool.and(isI64(b), Bool.or(Bool.and(op >= 124, op <= 126), Bool.or(Bool.and(op >= 131, op <= 138), Bool.and(op >= 81, op <= 90))))
        _ -> false

fn unHotOk(op: Int, a: Val) -> Bool
    ? "Whether a unary operation is an integer one that cannot trap: eqz, clz, ctz, popcnt, wrap, the extensions."
    match a
        Val.I32(_) -> Bool.or(Bool.or(op == 69, Bool.and(op >= 103, op <= 105)), Bool.or(Bool.or(op == 172, op == 173), Bool.and(op >= 192, op <= 193)))
        Val.I64(_) -> Bool.or(Bool.or(op == 80, Bool.and(op >= 121, op <= 123)), Bool.or(op == 167, Bool.and(op >= 194, op <= 196)))
        _ -> false

verify unHotOk
    unHotOk(69, Val.I32(0)) => true
    unHotOk(167, Val.I64(0)) => true
    unHotOk(170, Val.F64(0.0)) => false

fn arrayGetHot(x: Inst, s: Store, r: Val, k: Val, t: Int, e: Int) -> Option<Val>
    ? "array.get when the array is there and the index in bounds; None for the general path, which traps."
    match r
        Val.Ref(a) -> arrayGetIn(x, Kompost.arr(s.heap, a), idx(k), t, e)
        _ -> Option.None

fn arrayGetIn(x: Inst, o: Option<Arr>, k: Int, t: Int, e: Int) -> Option<Val>
    ? "Element k of an array's elements."
    match o
        Option.Some(arr) -> arrayElemUnpacked(Arr.get(arr, k), elemType(x, t), e)
        Option.None -> Option.None

fn arrayElemUnpacked(v: Option<Val>, et: ValType, e: Int) -> Option<Val>
    ? "An element read in bounds, unpacked."
    match v
        Option.Some(a) -> Option.Some(unpack(et, a, e))
        Option.None -> Option.None

fn arraySetOk(s: Store, r: Val, k: Val) -> Bool
    ? "Whether array.set will write: the array is there and the index in bounds."
    match r
        Val.Ref(a) -> idx(k) < arrLen(s, a)
        _ -> false

fn arrLen(s: Store, a: Int) -> Int
    ? "The length of the array at a, zero when there is none."
    arrayLength(Kompost.get(s.heap, a))

fn arrOfOpt(o: Option<Arr>) -> Arr
    ? "The elements found, handed on whole."
    match o
        Option.Some(e) -> e
        Option.None -> Arr.Flat(Vector.fromList([]))

verify arrOfOpt
    arrOfOpt(Option.None) => Arr.Flat(Vector.fromList([]))

fn arrVals(s: Store, a: Int) -> Arr
    ? "The elements of the array at a."
    arrOfOpt(Kompost.arr(s.heap, a))

fn arraySetDo(x: Inst, s: Store, r: Val, k: Val, v: Val, t: Int) -> Store
    ? "array.set that arraySetOk accepted."
    match r
        Val.Ref(a) -> Store.update(s, heap = Kompost.setElem(s.heap, a, idx(k), pack(elemType(x, t), v)))
        _ -> s

fn arrSet(r: Option<Arr>) -> Arr
    ? "An array after a write the caller checked was in bounds."
    match r
        Option.Some(a) -> a
        Option.None -> Arr.Flat(Vector.fromList([]))

fn isI32(v: Val) -> Bool
    ? "Whether a value is an i32."
    match v
        Val.I32(_) -> true
        _ -> false

fn isI64(v: Val) -> Bool
    ? "Whether a value is an i64."
    match v
        Val.I64(_) -> true
        _ -> false

verify binHotOk
    binHotOk(106, Val.I32(1), Val.I32(2)) => true
    binHotOk(109, Val.I32(1), Val.I32(2)) => false
    binHotOk(83, Val.I64(1), Val.I64(2)) => true
    binHotOk(106, Val.I32(1), Val.I64(2)) => false

verify isI32
    isI32(Val.I64(1)) => false

verify isI64
    isI64(Val.I64(1)) => true

fn binDo(op: Int, f: Frame) -> Frame
    ? "A binary operation binHotOk accepted, done on the frame: the commonest here, the rest through Num."
    match at(f, 1)
        Val.I32(a) -> put1(f, 2, binVal(i32Hot(op, a, Value.i32(at(f, 0))), op, at(f, 1), at(f, 0)))
        _ -> put1(f, 2, binVal(i64Hot(op, Value.i64(at(f, 1)), Value.i64(at(f, 0))), op, at(f, 1), at(f, 0)))

fn binVal(fast: Option<Val>, op: Int, a: Val, b: Val) -> Val
    ? "The fast result, or Num's."
    match fast
        Option.Some(v) -> v
        Option.None -> Result.withDefault(Num.binary(op, a, b), Val.Null)

fn brIfDo(f: Frame, l: Label) -> Frame
    ? "br_if to a target inside the function."
    match isTrue(at(f, 0))
        true -> jump(below(f, 1), l)
        false -> putN(f, 1)

fn ifNot(f: Frame, t: Int) -> Frame
    ? "A resolved if: on into the then arm when the condition holds, else to t."
    c = isTrue(at(f, 0))
    Frame.update(f, pc = pickPc(c, f.pc + 1, t), sp = f.sp - 1)

fn isNullIfNot(f: Frame, t: Int) -> Frame
    ? "ref.is_null then a resolved if, as one step: past both when the reference is null, else to t."
    c = Value.isNull(at(f, 0))
    Frame.update(f, pc = pickPc(c, f.pc + 2, t), sp = f.sp - 1)

fn setLocalBy(f: Frame, k: Int, v: Val, by: Int) -> Frame
    ? "The frame with local k set to v, moved on by instructions."
    Frame.update(f, pc = f.pc + by, locals = vset(f.locals, k, v))

fn copyLocal(f: Frame, a: Int, b: Int) -> Frame
    ? "local.get a then local.set b, as one step; the value is read before the frame is handed on."
    v = vget(f.locals, a)
    setLocalBy(f, b, v, 2)

fn castField(x: Inst, s: Store, f: Frame, a: Int, nl: Bool, h: Int, t: Int, k: Int, e: Int) -> Frame
    ? "local.get a, ref.cast, struct.get as one step when the cast holds on a struct; otherwise only the local.get, so the cast that follows traps or goes on alone."
    v = vget(f.locals, a)
    p = f.pc
    match castFieldVal(x, s, v, h, t, k, e)
        Option.Some(fv) -> Frame.update(pushOnly(f, fv), pc = p + 3)
        Option.None -> push(f, v)

fn castFieldVal(x: Inst, s: Store, v: Val, h: Int, t: Int, k: Int, e: Int) -> Option<Val>
    ? "Field k of the struct v refers to, when it is of heap type h."
    match v
        Val.Ref(r) -> fieldIfMatches(x, s, Kompost.get(s.heap, r), h, t, k, e)
        _ -> Option.None

fn fieldIfMatches(x: Inst, s: Store, o: Obj, h: Int, t: Int, k: Int, e: Int) -> Option<Val>
    ? "Field k of o when o is of heap type h."
    match objMatches(x, s, o, h)
        true -> Option.Some(fieldOf(x, o, t, k, e))
        false -> Option.None

fn testIfNot(x: Inst, s: Store, f: Frame, nl: Bool, h: Int, t: Int) -> Frame
    ? "ref.test then a resolved if, as one step."
    c = matches(x, s, at(f, 0), nl, h)
    Frame.update(f, pc = pickPc(c, f.pc + 2, t), sp = f.sp - 1)

verify setLocalBy
    vget(setLocalBy(bare(Vector.fromList([Val.Null]), 1, 0), 0, Val.I32(3), 2).locals, 0) => Val.I32(3)

verify copyLocal
    vget(copyLocal(bare(Vector.fromList([Val.I32(4), Val.Null]), 1, 0), 0, 1).locals, 1) => Val.I32(4)

verify castFieldVal
    castFieldVal(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule()), Val.Null, 0, 0, 0, 0) => Option.None

verify fieldIfMatches
    fieldIfMatches(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), blankStore(), Obj.Free, 0, 0, 0, 0) => Option.None

verify castField
    castField(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule()), bare(Vector.fromList([Val.Null]), 1, 0), 0, true, 0, 0, 0, 0).pc => 1

verify testIfNot
    testIfNot(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule()), pushOnly(bare(Vector.fromList([]), 1, 0), Val.Null), true, 0, 9).pc => 2

fn jumpIf(f: Frame, t: Int) -> Frame
    ? "A br_if that moves no values: pops the condition, then to t when it holds."
    c = isTrue(at(f, 0))
    Frame.update(f, pc = pickPc(c, t, f.pc + 1), sp = f.sp - 1)

fn pushBy(f: Frame, v: Val, by: Int) -> Frame
    ? "The frame with v pushed, moved on by instructions."
    p = f.pc
    Frame.update(pushOnly(f, v), pc = p + by)

fn nullTo2(f: Frame, a: Int, b: Int) -> Frame
    ? "ref.null, local.set a, ref.null, local.set b."
    Frame.update(f, pc = f.pc + 4, locals = vset(vset(f.locals, a, Val.Null), b, Val.Null))

fn constVal(k: Int, wide: Bool) -> Val
    ? "An i64 constant when wide, else an i32."
    match wide
        true -> Val.I64(k)
        false -> Val.I32(k)

fn getBrOnNull(f: Frame, a: Int, t: Int) -> Frame
    ? "local.get a then br_on_null t: to the target when the local is null, else the local pushed and past both. A target that returns runs as the local.get alone, so br_on_null returns."
    v = vget(f.locals, a)
    match Value.isNull(v)
        true -> nullBranch(f, v, t)
        false -> pushBy(f, v, 2)

fn nullBranch(f: Frame, v: Val, t: Int) -> Frame
    ? "The taken branch of getBrOnNull."
    match hotLabel(f, t)
        Option.Some(l) -> jump(f, l)
        Option.None -> push(f, v)

verify jumpIf
    jumpIf(pushOnly(bare(Vector.fromList([]), 1, 0), Val.I32(1)), 7).pc => 7

verify pushBy
    pushBy(bare(Vector.fromList([]), 1, 0), Val.Null, 3).pc => 3

verify nullTo2
    nullTo2(bare(Vector.fromList([Val.I32(1), Val.I32(2)]), 1, 0), 0, 1).locals => Vector.fromList([Val.Null, Val.Null])

verify constVal
    constVal(3, true) => Val.I64(3)

verify getBrOnNull
    getBrOnNull(bare(Vector.fromList([Val.I32(1)]), 1, 0), 0, 0).pc => 2

verify nullBranch
    nullBranch(bare(Vector.fromList([]), 1, 0), Val.Null, 0).pc => 1

fn brOnNullDo(f: Frame, l: Label) -> Frame
    ? "br_on_null to a target inside the function."
    match Value.isNull(at(f, 0))
        true -> jump(below(f, 1), l)
        false -> adv(f)

verify brOnNullDo
    brOnNullDo(pushOnly(bare(Vector.fromList([]), 1, 0), Val.I32(1)), Label(cont = 7, arity = 0, base = 0)).pc => 1
    brOnNullDo(pushOnly(bare(Vector.fromList([]), 1, 0), Val.Null), Label(cont = 7, arity = 0, base = 0)).pc => 7

// ---- Op2: a binary operation with its operands and its result in place ----

fn op2(f: Frame, op: Int, a: Int, b: Int, k: Int, out: Int, oa: Int, sk: Int) -> Frame
    ? "A non-trapping integer operation fused with where its operands come from and where its result goes. a is a local, or -1 for the stack; b a local, -1 for the stack or -2 for the constant k; out 0 pushes the result, 1 sets local oa, 2 is br_if to target oa, 3 an if whose false arm starts at oa. sk is how many instructions it stands for."
    vb = operandB(f, op, b, k)
    va = operandA(f, a, b)
    r = binOn(op, va, vb)
    pops = popsOf(a) + popsOf(b)
    outTo(f, r, pops, out, oa, sk)

fn operandB(f: Frame, op: Int, b: Int, k: Int) -> Val
    ? "The second operand: the top of the stack, the constant or a local."
    match b >= 0
        true -> vget(f.locals, b)
        false -> stackOrConst(f, op, b, k)

fn stackOrConst(f: Frame, op: Int, b: Int, k: Int) -> Val
    ? "The top of the stack for -1, the constant for -2."
    match b == -1
        true -> at(f, 0)
        false -> constOf(op, k)

verify stackOrConst
    stackOrConst(bare(Vector.fromList([]), 1, 0), 106, -2, 5) => Val.I32(5)

fn operandA(f: Frame, a: Int, b: Int) -> Val
    ? "The first operand: under the second on the stack, or a local."
    match a >= 0
        true -> vget(f.locals, a)
        false -> at(f, popsOf(b))

fn popsOf(src: Int) -> Int
    ? "1 when an operand comes from the stack."
    match src == -1
        true -> 1
        false -> 0

fn constOf(op: Int, k: Int) -> Val
    ? "The constant of an operation, i64 for the i64 operations."
    match isI64Op(op)
        true -> Val.I64(k)
        false -> Val.I32(k)

fn isI64Op(op: Int) -> Bool
    ? "Whether a binary operation works on i64."
    Bool.or(Bool.and(op >= 81, op <= 90), Bool.and(op >= 124, op <= 138))

fn binOn(op: Int, va: Val, vb: Val) -> Val
    ? "A non-trapping integer operation on two values."
    match va
        Val.I32(x) -> binVal(i32Hot(op, x, Value.i32(vb)), op, va, vb)
        Val.I64(x) -> binVal(i64Hot(op, x, Value.i64(vb)), op, va, vb)
        _ -> Result.withDefault(Num.binary(op, va, vb), Val.Null)

fn outTo(f: Frame, r: Val, pops: Int, out: Int, oa: Int, sk: Int) -> Frame
    ? "The result put where the operation sends it."
    match out
        0 -> Frame.update(f, stack = vset(f.stack, f.sp - pops, r), sp = f.sp - pops + 1, pc = f.pc + sk)
        1 -> Frame.update(f, sp = f.sp - pops, pc = f.pc + sk, locals = vset(f.locals, oa, r))
        2 -> brIfOut(f, isTrue(r), pops, oa, sk)
        3 -> Frame.update(f, sp = f.sp - pops, pc = pickPc(isTrue(r), f.pc + sk, oa))
        _ -> Frame.update(f, sp = f.sp - pops, pc = pickPc(isTrue(r), oa, f.pc + sk))

fn brIfOut(f: Frame, c: Bool, pops: Int, t: Int, sk: Int) -> Frame
    ? "br_if to target t with the operands gone: the fuser only sends a target inside the function here."
    match c
        true -> brIfTaken(below(f, pops), t)
        false -> Frame.update(f, sp = f.sp - pops, pc = f.pc + sk)

fn brIfTaken(f: Frame, t: Int) -> Frame
    ? "The jump of a taken br_if."
    match hotLabel(f, t)
        Option.Some(l) -> jump(f, l)
        Option.None -> f

verify op2
    op2(bare(Vector.fromList([Val.I32(2), Val.I32(3), Val.Null]), 1, 0), 106, 0, 1, 0, 1, 2, 4).locals => Vector.fromList([Val.I32(2), Val.I32(3), Val.I32(5)])
    vget(op2(pushOnly(bare(Vector.fromList([]), 2, 0), Val.I64(5)), 125, -1, -2, 2, 0, 0, 2).stack, 0) => Val.I64(3)
    op2(pushOnly(pushOnly(bare(Vector.fromList([]), 2, 0), Val.I32(1)), Val.I32(2)), 72, -1, -1, 0, 3, 9, 2).pc => 2

verify operandB
    operandB(bare(Vector.fromList([Val.I32(4)]), 1, 0), 106, 0, 0) => Val.I32(4)
    operandB(bare(Vector.fromList([]), 1, 0), 124, -2, 7) => Val.I64(7)

verify operandA
    operandA(pushOnly(pushOnly(bare(Vector.fromList([]), 2, 0), Val.I32(1)), Val.I32(2)), -1, -1) => Val.I32(1)

verify popsOf
    popsOf(-2) => 0

verify constOf
    constOf(106, 1) => Val.I32(1)

verify isI64Op
    isI64Op(83) => true
    isI64Op(79) => false

verify binOn
    binOn(115, Val.I32(6), Val.I32(3)) => Val.I32(5)
    binOn(134, Val.I64(1), Val.I64(4)) => Val.I64(16)

verify outTo
    outTo(bare(Vector.fromList([]), 1, 0), Val.I32(0), 0, 3, 8, 2).pc => 8

verify brIfOut
    brIfOut(bare(Vector.fromList([]), 1, 0), false, 0, 0, 3).pc => 3

verify brIfTaken
    brIfTaken(bare(Vector.fromList([]), 1, 0), 0).pc => 0

fn pickPc(c: Bool, a: Int, b: Int) -> Int
    ? "a when c holds, else b."
    match c
        true -> a
        false -> b

verify ifNot
    ifNot(pushOnly(bare(Vector.fromList([]), 1, 0), Val.I32(0)), 9).pc => 9
    ifNot(pushOnly(bare(Vector.fromList([]), 1, 0), Val.I32(1)), 9).pc => 1

verify isNullIfNot
    isNullIfNot(pushOnly(bare(Vector.fromList([]), 1, 0), Val.Null), 9).pc => 2

verify pickPc
    pickPc(false, 1, 2) => 2

fn fieldOf(x: Inst, o: Obj, t: Int, k: Int, e: Int) -> Val
    ? "Field k of a struct, unpacked."
    unpack(fieldType(x, t, k), Kompost.fieldAt(o, k), e)

fn i32Hot(op: Int, a: Int, b: Int) -> Option<Val>
    ? "add, sub, the bitwise operations and the comparisons on i32."
    match op
        106 -> Option.Some(Val.I32(Num.wrap32(a + b)))
        107 -> Option.Some(Val.I32(Num.wrap32(a - b)))
        113 -> Option.Some(Val.I32(Bits.and(a, b)))
        114 -> Option.Some(Val.I32(Bits.or(a, b)))
        115 -> Option.Some(Val.I32(Bits.xor(a, b)))
        _ -> cmpHot(op, a, b, 70)

fn i64Hot(op: Int, a: Int, b: Int) -> Option<Val>
    ? "add, sub, the bitwise operations and the comparisons on i64."
    match op
        124 -> Option.Some(Val.I64(Num.wrap64(a + b)))
        125 -> Option.Some(Val.I64(Num.wrap64(a - b)))
        131 -> Option.Some(Val.I64(Bits.and(a, b)))
        132 -> Option.Some(Val.I64(Bits.or(a, b)))
        133 -> Option.Some(Val.I64(Bits.xor(a, b)))
        _ -> cmpHot(op, a, b, 81)

fn cmpHot(op: Int, a: Int, b: Int, first: Int) -> Option<Val>
    ? "A comparison when op is one of the ten from first, None otherwise."
    match Bool.and(op >= first, op <= first + 9)
        true -> Option.Some(boolVal(Num.icmp(op, a, b)))
        false -> Option.None

verify i32Hot
    i32Hot(106, 2147483647, 1) => Option.Some(Val.I32(-2147483648))
    i32Hot(73, -1, 0) => Option.Some(Val.I32(0))
    i32Hot(108, 2, 3) => Option.None

verify i64Hot
    i64Hot(124, 1, 2) => Option.Some(Val.I64(3))
    i64Hot(83, -1, 0) => Option.Some(Val.I32(1))

verify cmpHot
    cmpHot(80, 1, 2, 70) => Option.None

fn jump(f: Frame, l: Label) -> Frame
    ? "The frame at target l: its values kept on the stack above its base, the program counter where it continues."
    Frame.update(keep(f, l.arity, l.base), pc = l.cont)

verify jump
    jump(bare(Vector.fromList([]), 2, 0), Label(cont = 5, arity = 0, base = 0)).pc => 5

fn keep(f: Frame, arity: Int, base: Int) -> Frame
    ? "The stack cut down to base with the top arity values kept on it."
    match f.sp - arity == base
        true -> f
        false -> keepMove(f, arity, base, 0)

fn keepMove(f: Frame, arity: Int, base: Int, k: Int) -> Frame
    ? "Moves the top arity values down to base, the lowest first."
    match k >= arity
        true -> Frame.update(f, sp = base + arity)
        false -> keepMove(moveOne(f, base + k, arity - k), arity, base, k + 1)

fn moveOne(f: Frame, i: Int, back: Int) -> Frame
    ? "The frame with the stack slot back places below the top copied to slot i, in place: the value is read before the frame is handed on."
    v = vget(f.stack, f.sp - back)
    Frame.update(f, stack = vset(f.stack, i, v))

verify moveOne
    vget(moveOne(pushOnly(bare(Vector.fromList([]), 2, 0), Val.I32(7)), 1, 1).stack, 1) => Val.I32(7)

fn exec(x: Inst, i: Instr, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "One instruction."
    match i
        Instr.LocalGet(k) -> go(x, push(f, vget(f.locals, k)), calls, s)
        Instr.I32Const(c) -> go(x, push(f, Val.I32(c)), calls, s)
        Instr.I64Const(c) -> go(x, push(f, Val.I64(c)), calls, s)
        Instr.LocalSet(k) -> localSet(x, f, k, calls, s)
        Instr.LocalTee(k) -> localTee(x, f, k, calls, s)
        Instr.Bin(op) -> binOp(x, op, f, calls, s)
        Instr.Un(op) -> unOp(x, op, f, calls, s)
        Instr.BrIf(d) -> brIf(x, f, d, calls, s)
        Instr.Br(d) -> branch(x, f, d, calls, s)
        Instr.Jump(t) -> go(x, Frame.update(f, pc = t), calls, s)
        Instr.IfNot(t) -> go(x, ifNot(f, t), calls, s)
        Instr.IsNullIfNot(t) -> go(x, isNullIfNot(f, t), calls, s)
        Instr.End -> doReturn(x, f, calls, s)
        Instr.StructGet(t, k, e) -> structGet(x, f, t, k, e, calls, s)
        Instr.Call(fi) -> call(x, fi, f, calls, s, false)
        Instr.ReturnCall(fi) -> call(x, fi, f, calls, s, true)
        Instr.Return -> doReturn(x, f, calls, s)
        Instr.RefIsNull -> refIsNull(x, f, calls, s)
        Instr.RefNull(_) -> go(x, push(f, Val.Null), calls, s)
        Instr.GlobalGet(k) -> go(x, push(f, vget(s.globals, gaddr(x, k))), calls, s)
        Instr.Drop -> go(x, putN(f, 1), calls, s)
        _ -> execRest(x, i, f, calls, s)

fn execRest(x: Inst, i: Instr, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "The less frequent instructions."
    match i
        Instr.Nop -> go(x, adv(f), calls, s)
        Instr.Unreachable -> trap("unreachable", s)
        Instr.Throw(t) -> throwTag(x, f, t, calls, s)
        Instr.ThrowRef -> throwRef(x, f, calls, s)
        Instr.Simd(op, imm, k, off, _) -> simdOp(x, f, op, imm, k, off, calls, s)
        Instr.BrTable(ls, d) -> brTable(x, f, ls, d, calls, s)
        Instr.CallRef(t) -> callRef(x, t, f, calls, s, false)
        Instr.ReturnCallRef(t) -> callRef(x, t, f, calls, s, true)
        Instr.CallIndirect(t, tb) -> callIndirect(x, t, tb, f, calls, s, false)
        Instr.ReturnCallIndirect(t, tb) -> callIndirect(x, t, tb, f, calls, s, true)
        Instr.Select -> select(x, f, calls, s)
        Instr.SelectT(_) -> select(x, f, calls, s)
        Instr.GlobalSet(k) -> globalSet(x, f, k, calls, s)
        Instr.F64Const(b) -> go(x, push(f, Num.f64Val(b)), calls, s)
        Instr.F32Const(b) -> go(x, push(f, Num.f32Val(b)), calls, s)
        Instr.RefFunc(k) -> go(x, push(f, Val.Func(x.base + k)), calls, s)
        Instr.RefEq -> refEq(x, f, calls, s)
        Instr.RefAsNonNull -> refAsNonNull(x, f, calls, s)
        Instr.BrOnNull(d) -> brOnNull(x, f, d, calls, s)
        Instr.BrOnNonNull(d) -> brOnNonNull(x, f, d, calls, s)
        Instr.RefTest(n, h) -> refTest(x, f, n, h, calls, s)
        Instr.RefCast(n, h) -> refCast(x, f, n, h, calls, s)
        Instr.BrOnCast(d, fl, _, h) -> brOnCast(x, f, d, Bits.and(fl, 2) == 2, h, true, calls, s)
        Instr.BrOnCastFail(d, fl, _, h) -> brOnCast(x, f, d, Bits.and(fl, 2) == 2, h, false, calls, s)
        Instr.RefI31 -> refI31(x, f, calls, s)
        Instr.I31Get(sg) -> i31Get(x, f, sg, calls, s)
        Instr.AnyConvertExtern -> go(x, adv(f), calls, s)
        Instr.ExternConvertAny -> go(x, adv(f), calls, s)
        _ -> execHeap(x, i, f, calls, s)

fn execHeap(x: Inst, i: Instr, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "Instructions that change the store: memory, tables, structs and arrays."
    match i
        Instr.StructNew(t) -> structNew(x, f, t, false, calls, s)
        Instr.StructNewDefault(t) -> structNew(x, f, t, true, calls, s)
        Instr.StructSet(t, k) -> structSet(x, f, t, k, calls, s)
        Instr.ArrayNew(t) -> arrayNew(x, f, t, calls, s)
        Instr.ArrayNewDefault(t) -> arrayNewDefault(x, f, t, calls, s)
        Instr.ArrayNewFixed(t, n) -> arrayNewFixed(x, f, t, n, calls, s)
        Instr.ArrayNewData(t, d) -> arrayNewData(x, f, t, d, calls, s)
        Instr.ArrayNewElem(t, e) -> arrayNewElem(x, f, t, e, calls, s)
        Instr.ArrayGet(t, e) -> arrayGet(x, f, t, e, calls, s)
        Instr.ArraySet(t) -> arraySet(x, f, t, calls, s)
        Instr.ArrayLen -> arrayLen(x, f, calls, s)
        Instr.ArrayFill(t) -> arrayFill(x, f, t, calls, s)
        Instr.ArrayCopy(_, _) -> arrayCopy(x, f, calls, s)
        Instr.ArrayInitData(t, d) -> arrayInitData(x, f, t, d, calls, s)
        Instr.ArrayInitElem(_, e) -> arrayInitElem(x, f, e, calls, s)
        Instr.Load(op, off, _, k) -> onMem(x, k, load(x, f, op, off, calls, withMem(x, s, k)))
        Instr.Store(op, off, _, k) -> onMem(x, k, store(x, f, op, off, calls, withMem(x, s, k)))
        Instr.MemorySize(k) -> onMem(x, k, memorySize(x, f, Ast.memIs64(x.m, k), calls, withMem(x, s, k)))
        Instr.MemoryGrow(k) -> onMem(x, k, memoryGrow(x, f, Ast.memIs64(x.m, k), calls, withMem(x, s, k)))
        Instr.MemoryFill(k) -> onMem(x, k, memoryFill(x, f, calls, withMem(x, s, k)))
        Instr.MemoryCopy(a, b) -> memoryCopyIn(x, f, a, b, calls, s)
        Instr.MemoryInit(d, k) -> onMem(x, k, memoryInit(x, f, d, calls, withMem(x, s, k)))
        Instr.DataDrop(d) -> go(x, adv(f), calls, Store.update(s, datas = Option.withDefault(Vector.set(s.datas, daddr(x, d), Vector.fromList([])), s.datas)))
        Instr.ElemDrop(e) -> go(x, adv(f), calls, Store.update(s, elems = dropSeg(s.elems, eaddr(x, e))))
        Instr.TableGet(t) -> tableGet(x, f, t, calls, s)
        Instr.TableSet(t) -> tableSet(x, f, t, calls, s)
        Instr.TableSize(t) -> go(x, push(f, sized(Ast.tableIs64(x.m, t), Vector.len(table(s, taddr(x, t))))), calls, s)
        Instr.TableGrow(t) -> tableGrow(x, f, t, calls, s)
        Instr.TableFill(t) -> tableFill(x, f, t, calls, s)
        Instr.TableCopy(d, sr) -> tableCopy(x, f, d, sr, calls, s)
        Instr.TableInit(e, t) -> tableInit(x, f, e, t, calls, s)
        Instr.Bad(op) -> trap("unknown opcode {op}", s)
        _ -> trap("unsupported instruction", s)

// ---- control ----

fn branch(x: Inst, f: Frame, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "A branch to target d: keeps the target's values on top of the stack above its base and continues where it says; the function's own target returns."
    match hotLabel(f, d)
        Option.Some(l) -> go(x, jump(f, l), calls, s)
        Option.None -> doReturn(x, f, calls, s)

fn brIf(x: Inst, f: Frame, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "br_if d."
    brIfOn(x, below(f, 1), isTrue(at(f, 0)), d, calls, s)

fn brIfOn(x: Inst, f: Frame, c: Bool, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "Branches when the condition held, else moves on."
    match c
        true -> branch(x, f, d, calls, s)
        false -> go(x, adv(f), calls, s)

fn brTable(x: Inst, f: Frame, ls: Vector<Int>, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "br_table: the label at the popped index, or the default."
    branch(x, below(f, 1), Option.withDefault(Vector.get(ls, idx(at(f, 0))), d), calls, s)

fn doReturn(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "Returns the frame's results to its caller, or ends the run when there is none."
    match calls
        [] -> Next.Out(Outcome.Done(List.reverse(top(f, f.arity)), s))
        [c, ..rest] -> go(x, returnTo(f, c), rest, s)

// ---- SIMD ----

fn simdOp(x: Inst, f: Frame, op: Int, imm: Int, k: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A SIMD instruction: memory ones on memory k, the rest pure (see Simd.pure)."
    match Simd.isMem(op)
        true -> onMem(x, k, simdMem(x, f, op, imm, off, calls, withMem(x, s, k)))
        false -> simdPure(x, f, op, imm, calls, s)

fn simdPure(x: Inst, f: Frame, op: Int, imm: Int, calls: List<Frame>, s: Store) -> Next
    ? "Pops the operands, pushes the result."
    n = Simd.arity(op)
    go(x, put1(f, n, Simd.pure(op, imm, List.reverse(top(f, n)))), calls, s)

fn simdMem(x: Inst, f: Frame, op: Int, imm: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A SIMD load or store with its memory in the place of memory 0."
    match Bool.or(op == 11, Bool.and(op >= 88, op <= 91))
        true -> simdStore(x, f, op, imm, off, calls, s)
        false -> simdLoad(x, f, op, imm, off, calls, s)

fn simdLoad(x: Inst, f: Frame, op: Int, imm: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A load; a lane load also pops the vector whose lane it replaces."
    match Bool.and(op >= 84, op <= 87)
        true -> simdLoadLane(x, f, op, imm, off, calls, s)
        false -> simdLoadPlain(x, f, op, imm, off, calls, s)

fn simdLoadPlain(x: Inst, f: Frame, op: Int, imm: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A load from an address."
    match top(f, 1)
        [a, .._] -> simdLoadAt(x, f, op, imm, idx(a) + off, Val.Null, 1, calls, s)
        [] -> underflow(s)

fn simdLoadLane(x: Inst, f: Frame, op: Int, imm: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "load_lane: an address and a vector."
    match top(f, 2)
        [vec, a, .._] -> simdLoadAt(x, f, op, imm, idx(a) + off, vec, 2, calls, s)
        _ -> underflow(s)

fn simdLoadAt(x: Inst, f: Frame, op: Int, imm: Int, ea: Int, old: Val, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Reads after the bounds check."
    n = Simd.accessSize(op)
    match ea + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> go(x, put1(f, popped, Simd.loaded(op, imm, Mem.read(s.mem, ea, n), old)), calls, s)

fn simdStore(x: Inst, f: Frame, op: Int, imm: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "v128.store and store_lane: an address and a vector."
    match top(f, 2)
        [vec, a, .._] -> simdStoreAt(x, f, idx(a) + off, Simd.stored(op, imm, vec), calls, s)
        _ -> underflow(s)

fn simdStoreAt(x: Inst, f: Frame, ea: Int, bs: List<Int>, calls: List<Frame>, s: Store) -> Next
    ? "Writes the octets after the bounds check."
    match ea + List.len(bs) > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> go(x, putN(f, 2), calls, Store.update(s, mem = Mem.writeList(s.mem, ea, bs)))

// ---- exceptions ----

fn throwTag(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "throw: the tag's values become an exception on the heap (a struct whose type is -100 less the tag), which unwinds to the nearest handler."
    n = List.len(Ast.funcParams(x.m, Ast.tagType(x.m, t)))
    vs = List.reverse(top(f, n))
    g = tagId(x, t)
    thrown(x, g, vs, alloc(x, f, n, Kompost.mkStruct(-100 - g, vs), Option.None, calls, s))

fn tagId(x: Inst, t: Int) -> Int
    ? "The identity of tag t across linked instances: the one Link gave it, else the instance's base plus t (just t for a lone module)."
    Option.withDefault(Vector.get(x.tags, t), x.base + t)

verify tagId
    tagId(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 2) => 2
    tagId(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([9]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 0) => 9

fn resumeThrow(x: Inst, mach: Machine, t: Int, vs: List<Val>) -> Outcome
    ? "Continues a machine that called into another instance, which threw tag t (an identity, see tagId) with values vs: the exception is made in this store and unwinds from the call."
    f = Frame.update(mach.frame, pc = mach.frame.pc - 1)
    proceed(x, thrown(x, t, vs, alloc(x, f, 0, Kompost.mkStruct(-100 - t, vs), Option.None, mach.calls, mach.store)))

fn thrown(x: Inst, t: Int, vs: List<Val>, r: Next) -> Next
    ? "Takes the new exception's reference off the stack and unwinds."
    match r
        Next.Go(f, calls, s) -> thrownAt(x, t, vs, at(f, 0), below(f, 1), calls, s)
        Next.Out(o) -> Next.Out(o)

fn thrownAt(x: Inst, t: Int, vs: List<Val>, r: Val, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "Unwinds with the exception at its address."
    match r
        Val.Ref(a) -> unwind(x, f, calls, s, a, t, vs)
        _ -> trap("exception not allocated", s)

fn throwRef(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "throw_ref: throws an exception again."
    match at(f, 0)
        Val.Ref(a) -> rethrow(x, putN(f, 1), a, Kompost.get(s.heap, a), calls, s)
        _ -> trap("null exception reference", s)

fn rethrow(x: Inst, f: Frame, a: Int, o: Obj, calls: List<Frame>, s: Store) -> Next
    ? "Unwinds with an exception read back from the heap."
    unwind(x, f, calls, s, a, -100 - Kompost.typeOf(o), Kompost.fieldsOf(o))

record Hit
    kind: Int
    target: Int

fn unwind(x: Inst, f: Frame, calls: List<Frame>, s: Store, a: Int, t: Int, vs: List<Val>) -> Next
    ? "Looks for a handler of tag t around the instruction before f's program counter (the throw, or the call a caller waits on), then in the callers; none is a trap."
    match handlerAt(x, f.code, Vector.len(f.code) - 1, f.pc - 1, t)
        Option.Some(h) -> caught(x, f, h, a, vs, calls, s)
        Option.None -> unwindOut(x, calls, s, a, t, vs)

fn unwindOut(x: Inst, calls: List<Frame>, s: Store, a: Int, t: Int, vs: List<Val>) -> Next
    ? "Leaves a frame without a handler."
    match calls
        [c, ..rest] -> unwind(x, c, rest, s, a, t, vs)
        [] -> Next.Out(Outcome.Thrown(t, vs, s))

fn handlerAt(x: Inst, code: Vector<Instr>, k: Int, p: Int, t: Int) -> Option<Hit>
    ? "The first handler, scanning back from the end of the code (innermost first), whose range holds p and whose clause takes tag t (an identity, see tagId)."
    match Vector.get(code, k)
        Option.Some(Instr.Handler(from, to, kind, tg, ti)) -> handlerIf(x, code, k, p, t, Bool.and(Bool.and(from <= p, p < to), Bool.or(kind >= 2, tagId(x, tg) == t)), Hit(kind = kind, target = ti))
        _ -> Option.None

fn handlerIf(x: Inst, code: Vector<Instr>, k: Int, p: Int, t: Int, takes: Bool, h: Hit) -> Option<Hit>
    ? "h when it takes the exception, else the search goes on."
    match takes
        true -> Option.Some(h)
        false -> handlerAt(x, code, k - 1, p, t)

fn caught(x: Inst, f: Frame, h: Hit, a: Int, vs: List<Val>, calls: List<Frame>, s: Store) -> Next
    ? "Hands the clause's values to its label: the stack is cut to the label's base first."
    l = Option.withDefault(Vector.get(f.targets, h.target), Label(cont = -1, arity = 0, base = 0))
    branch(x, pushAll(Frame.update(f, sp = l.base), payload(h.kind, a, vs)), h.target, calls, s)

fn payload(kind: Int, a: Int, vs: List<Val>) -> List<Val>
    ? "What a clause hands on: the values (catch), the values and the exception (catch_ref), nothing (catch_all), the exception (catch_all_ref)."
    match kind
        0 -> vs
        1 -> List.concat(vs, [Val.Ref(a)])
        2 -> []
        _ -> [Val.Ref(a)]

verify payload
    payload(1, 3, [Val.I32(1)]) => [Val.I32(1), Val.Ref(3)]
    payload(2, 3, [Val.I32(1)]) => []

verify handlerAt
    handlerAt(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Vector.fromList([Instr.End, Instr.Handler(0, 5, 0, 1, 7), Instr.Handler(2, 4, 0, 2, 6)]), 2, 3, 1) => Option.Some(Hit(kind = 0, target = 7))
    handlerAt(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Vector.fromList([Instr.End, Instr.Handler(0, 5, 0, 1, 7)]), 1, 6, 1) => Option.None

verify handlerIf
    handlerIf(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Vector.fromList([]), 0, 0, 0, true, Hit(kind = 2, target = 1)) => Option.Some(Hit(kind = 2, target = 1))

verify unwindOut
    unwindOut(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), [], emptyStore(Ast.emptyModule()), 0, 0, []) => Next.Out(Outcome.Thrown(0, [], emptyStore(Ast.emptyModule())))

fn call(x: Inst, fi: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "call or return_call of function fi."
    match Vector.get(x.fns, fi)
        Option.Some(g) -> callFn(x, g, fi, f, calls, s, tail)
        Option.None -> trap("call to undefined function {fi}", s)

fn callFn(x: Inst, g: Fn, fi: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Pops the arguments and enters the function, or stops for the host when it is imported."
    caller = putN(f, g.params)
    match g.imported
        true -> Next.Out(Outcome.Host(fi, List.reverse(top(f, g.params)), tail, Machine(frame = caller, calls = calls, store = s)))
        false -> enter(x, g, f, caller, calls, s, tail)

fn enter(x: Inst, g: Fn, f: Frame, caller: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Runs a local function with its arguments, taken from f's stack, as its first locals."
    d = f.depth
    callee = frame(g.code, g.targets, setArgs(g.defaults, f, g.params), g.cap, g.results)
    match tail
        true -> go(x, Frame.update(callee, depth = d), calls, s)
        false -> match d >= maxDepth()
            true -> trap("call stack exhausted", s)
            false -> go(x, Frame.update(callee, depth = d + 1), List.prepend(caller, calls), s)

fn setArgs(v: Vector<Val>, f: Frame, n: Int) -> Vector<Val>
    ? "The locals with the top n values of f's stack as the first n, in order."
    setArgsFrom(v, f, n, 0)

fn setArgsFrom(v: Vector<Val>, f: Frame, n: Int, k: Int) -> Vector<Val>
    ? "Writes argument k on."
    match k >= n
        true -> v
        false -> setArgsFrom(vset(v, k, at(f, n - 1 - k)), f, n, k + 1)

fn callRef(x: Inst, t: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "call_ref: calls the function reference on top of the stack, of type t."
    match at(f, 0)
        Val.Func(a) -> callAt(x, t, a, below(f, 1), calls, s, tail)
        _ -> trap("null function reference", s)

fn callAt(x: Inst, t: Int, a: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Calls the function at address a: one of this instance's (its address less the instance's base), or another instance's, which the host is asked to run, with the arguments type t says."
    fi = a - x.base
    match Bool.and(fi >= 0, fi < Vector.len(x.fns))
        true -> call(x, fi, f, calls, s, tail)
        false -> foreignCall(a, List.len(Ast.funcParams(x.m, t)), f, calls, s, tail)

fn foreignCall(a: Int, n: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Stops for the host to call another instance's function: the import number is -1 less the address, so it is never one of this instance's imports."
    Next.Out(Outcome.Host(-1 - a, List.reverse(top(f, n)), tail, Machine(frame = putN(f, n), calls = calls, store = s)))

fn isLocal(x: Inst, a: Int) -> Bool
    ? "Whether function address a is this instance's."
    Bool.and(a >= x.base, a - x.base < Vector.len(x.fns))

verify isLocal
    isLocal(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 0) => false

fn callIndirect(x: Inst, t: Int, tb: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "call_indirect: the table entry at the popped index, checked against type t."
    callEntry(x, t, Vector.get(table(s, taddr(x, tb)), idx(at(f, 0))), below(f, 1), calls, s, tail)

fn callEntry(x: Inst, t: Int, e: Option<Val>, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Calls a table entry when it is a function of the right type."
    match e
        Option.Some(Val.Func(a)) -> callChecked(x, t, a, f, calls, s, tail)
        Option.Some(_) -> trap("uninitialized element", s)
        Option.None -> trap("undefined element", s)

fn callChecked(x: Inst, t: Int, a: Int, f: Frame, calls: List<Frame>, s: Store, tail: Bool) -> Next
    ? "Calls the function at address a when its type is t or a subtype of it; another instance's function is checked against its own module's type (see funcSub)."
    match isLocal(x, a)
        false -> match funcSub(x, s, a, t)
            true -> callAt(x, t, a, f, calls, s, tail)
            false -> trap("indirect call type mismatch", s)
        true -> match isSub(x.m, fnType(x, a - x.base), t, 64)
            true -> call(x, a - x.base, f, calls, s, tail)
            false -> trap("indirect call type mismatch", s)

fn fnType(x: Inst, fi: Int) -> Int
    ? "The type index of function fi."
    match Vector.get(x.fns, fi)
        Option.Some(g) -> g.ty
        Option.None -> -1

fn select(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "select: the first operand when the condition holds, else the second."
    match top(f, 3)
        [c, b, a, .._] -> go(x, put1(f, 3, pick(isTrue(c), a, b)), calls, s)
        _ -> underflow(s)

fn pick(c: Bool, a: Val, b: Val) -> Val
    ? "a when c holds, else b."
    match c
        true -> a
        false -> b

verify pick
    pick(true, Val.I32(1), Val.I32(2)) => Val.I32(1)
    pick(false, Val.I32(1), Val.I32(2)) => Val.I32(2)

// ---- variables and numbers ----

fn localSet(x: Inst, f: Frame, k: Int, calls: List<Frame>, s: Store) -> Next
    ? "local.set."
    go(x, Frame.update(f, pc = f.pc + 1, sp = f.sp - 1, locals = vset(f.locals, k, at(f, 0))), calls, s)

fn localTee(x: Inst, f: Frame, k: Int, calls: List<Frame>, s: Store) -> Next
    ? "local.tee."
    go(x, Frame.update(f, pc = f.pc + 1, locals = vset(f.locals, k, at(f, 0))), calls, s)

fn globalSet(x: Inst, f: Frame, k: Int, calls: List<Frame>, s: Store) -> Next
    ? "global.set."
    match top(f, 1)
        [v, .._] -> go(x, putN(f, 1), calls, Store.update(s, globals = vset(s.globals, gaddr(x, k), v)))
        [] -> underflow(s)

fn unOp(x: Inst, op: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "A unary numeric instruction."
    match top(f, 1)
        [a, .._] -> numResult(x, Num.unary(op, a), 1, f, calls, s)
        [] -> underflow(s)

fn binOp(x: Inst, op: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "A binary numeric instruction; the common i32 and i64 ones are computed here, without going through Num's dispatch."
    match top(f, 2)
        [Val.I32(b), Val.I32(a), .._] -> i32Fast(x, op, a, b, 2, f, calls, s)
        [Val.I64(b), Val.I64(a), .._] -> i64Fast(x, op, a, b, 2, f, calls, s)
        [b, a, .._] -> numResult(x, Num.binary(op, a, b), 2, f, calls, s)
        _ -> underflow(s)

fn i32Fast(x: Inst, op: Int, a: Int, b: Int, popped: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "add, sub, the bitwise operations and the comparisons on i32."
    match op
        106 -> go(x, put1(f, popped, Val.I32(Num.wrap32(a + b))), calls, s)
        107 -> go(x, put1(f, popped, Val.I32(Num.wrap32(a - b))), calls, s)
        113 -> go(x, put1(f, popped, Val.I32(Bits.and(a, b))), calls, s)
        114 -> go(x, put1(f, popped, Val.I32(Bits.or(a, b))), calls, s)
        115 -> go(x, put1(f, popped, Val.I32(Bits.xor(a, b))), calls, s)
        _ -> i32FastCmp(x, op, a, b, popped, f, calls, s)

fn i32FastCmp(x: Inst, op: Int, a: Int, b: Int, popped: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "The i32 comparisons, or the general path."
    match Bool.and(op >= 70, op <= 79)
        true -> go(x, put1(f, popped, boolVal(Num.icmp(op, a, b))), calls, s)
        false -> numResult(x, Num.binary(op, Val.I32(a), Val.I32(b)), popped, f, calls, s)

fn i64Fast(x: Inst, op: Int, a: Int, b: Int, popped: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "add, sub, the bitwise operations and the comparisons on i64."
    match op
        124 -> go(x, put1(f, popped, Val.I64(Num.wrap64(a + b))), calls, s)
        125 -> go(x, put1(f, popped, Val.I64(Num.wrap64(a - b))), calls, s)
        131 -> go(x, put1(f, popped, Val.I64(Bits.and(a, b))), calls, s)
        132 -> go(x, put1(f, popped, Val.I64(Bits.or(a, b))), calls, s)
        133 -> go(x, put1(f, popped, Val.I64(Bits.xor(a, b))), calls, s)
        _ -> i64FastCmp(x, op, a, b, popped, f, calls, s)

fn i64FastCmp(x: Inst, op: Int, a: Int, b: Int, popped: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "The i64 comparisons, or the general path."
    match Bool.and(op >= 81, op <= 90)
        true -> go(x, put1(f, popped, boolVal(Num.icmp(op, a, b))), calls, s)
        false -> numResult(x, Num.binary(op, Val.I64(a), Val.I64(b)), popped, f, calls, s)

fn numResult(x: Inst, r: Result<Val, String>, popped: Int, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "Pushes a numeric result, or traps."
    match r
        Result.Ok(v) -> go(x, put1(f, popped, v), calls, s)
        Result.Err(e) -> trap(e, s)

// ---- references ----

fn refIsNull(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "ref.is_null."
    match top(f, 1)
        [r, .._] -> go(x, put1(f, 1, boolVal(Value.isNull(r))), calls, s)
        [] -> underflow(s)

fn boolVal(b: Bool) -> Val
    ? "A Bool as an i32."
    match b
        true -> Val.I32(1)
        false -> Val.I32(0)

verify boolVal
    boolVal(true) => Val.I32(1)
    boolVal(false) => Val.I32(0)

fn refEq(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "ref.eq: same reference, or both null, or equal i31 values."
    match top(f, 2)
        [b, a, .._] -> go(x, put1(f, 2, boolVal(a == b)), calls, s)
        _ -> underflow(s)

fn refAsNonNull(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "ref.as_non_null."
    match top(f, 1)
        [Val.Null, .._] -> trap("null reference", s)
        _ -> go(x, adv(f), calls, s)

fn brOnNull(x: Inst, f: Frame, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "br_on_null: branches without the reference when it is null."
    match top(f, 1)
        [Val.Null, .._] -> branch(x, below(f, 1), d, calls, s)
        _ -> go(x, adv(f), calls, s)

fn brOnNonNull(x: Inst, f: Frame, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "br_on_non_null: branches with the reference when it is not null, drops it otherwise."
    match top(f, 1)
        [Val.Null, .._] -> go(x, putN(f, 1), calls, s)
        _ -> branch(x, f, d, calls, s)

fn refTest(x: Inst, f: Frame, n: Bool, h: Int, calls: List<Frame>, s: Store) -> Next
    ? "ref.test."
    match top(f, 1)
        [r, .._] -> go(x, put1(f, 1, boolVal(matches(x, s, r, n, h))), calls, s)
        [] -> underflow(s)

fn refCast(x: Inst, f: Frame, n: Bool, h: Int, calls: List<Frame>, s: Store) -> Next
    ? "ref.cast: traps when the reference is not of the type."
    match top(f, 1)
        [r, .._] -> castOn(x, f, matches(x, s, r, n, h), calls, s)
        [] -> underflow(s)

fn castOn(x: Inst, f: Frame, ok: Bool, calls: List<Frame>, s: Store) -> Next
    ? "Moves on after a cast that held, traps after one that did not."
    match ok
        true -> go(x, adv(f), calls, s)
        false -> trap("cast failure", s)

fn brOnCast(x: Inst, f: Frame, d: Int, n: Bool, h: Int, onMatch: Bool, calls: List<Frame>, s: Store) -> Next
    ? "br_on_cast (onMatch) and br_on_cast_fail: branches with the reference when the test comes out as asked."
    match top(f, 1)
        [r, .._] -> brIfOn(x, f, matches(x, s, r, n, h) == onMatch, d, calls, s)
        [] -> underflow(s)

fn matches(x: Inst, s: Store, r: Val, nullable: Bool, h: Int) -> Bool
    ? "Whether reference r is of the reference type (nullable, h). externref and anyref share one representation: anything non-null is an extern (-17), and a host value made internal by any.convert_extern is an any (-18) but nothing below it."
    match r
        Val.Null -> nullable
        Val.I31(_) -> Bool.or(Bool.or(h == -20, h == -17), Bool.or(h == -19, h == -18))
        Val.Ref(a) -> Bool.or(h == -17, objMatches(x, s, Kompost.get(s.heap, a), h))
        Val.Func(a) -> Bool.or(h == -16, Bool.and(h >= 0, funcSub(x, s, a, h)))
        Val.Host(_) -> Bool.or(h == -17, h == -18)
        _ -> false

fn objMatches(x: Inst, s: Store, o: Obj, h: Int) -> Bool
    ? "Whether a heap object is of heap type h. Its type is an identity: the allocating instance's base plus its type index."
    match o
        Obj.Free -> false
        Obj.Array(t, _) -> Bool.or(Bool.or(h == -18, h == -19), Bool.or(h == -22, Bool.and(h >= 0, typeSub(x, s, t, h))))
        _ -> Bool.or(Bool.or(h == -18, h == -19), Bool.or(h == -21, Bool.and(h >= 0, typeSub(x, s, Kompost.typeOf(o), h))))

fn typeSub(x: Inst, s: Store, tid: Int, h: Int) -> Bool
    ? "Whether the type with identity tid is a subtype of x's type h: within x by x's own rules, across instances by Types.subX on the two modules."
    match Bool.and(tid >= x.base, tid - x.base < Vector.len(x.m.types))
        true -> isSub(x.m, tid - x.base, h, 64)
        false -> match Map.get(s.mods, Int.div(tid, 4294967296))
            Option.Some(om) -> Types.subX(om, Int.mod(tid, 4294967296), x.m, h, 8)
            Option.None -> false

fn funcSub(x: Inst, s: Store, a: Int, h: Int) -> Bool
    ? "Whether the function at address a is of x's type h, wherever it lives."
    match isLocal(x, a)
        true -> isSub(x.m, fnType(x, a - x.base), h, 64)
        false -> match Map.get(s.mods, Int.div(a, 4294967296))
            Option.Some(om) -> Types.subX(om, modFnType(om, Int.mod(a, 4294967296)), x.m, h, 8)
            Option.None -> false

fn modFnType(m: Module, fi: Int) -> Int
    ? "The type index of function fi of module m."
    match Vector.get(m.funcs, fi)
        Option.Some(Func.Imported(_, _, t)) -> t
        Option.Some(Func.Local(t, _, _)) -> t
        Option.None -> -1

verify typeSub
    typeSub(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), blankStore(), 4294967296, 0) => false

verify funcSub
    funcSub(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), blankStore(), 4294967296, 0) => false

verify modFnType
    modFnType(Ast.emptyModule(), 0) => -1

fn isSub(m: Module, t: Int, target: Int, fuel: Int) -> Bool
    ? "Whether type t is target, up to iso-recursive equivalence, or declares it among its supertypes, transitively."
    match canonOf(m, t) == canonOf(m, target)
        true -> true
        false -> supersReach(m, supersOf(m, t), target, fuel - 1)

fn canonOf(m: Module, t: Int) -> Int
    ? "The canonical index of type t; t itself when the module has no canonical table."
    Option.withDefault(Vector.get(m.canon, t), t)

verify canonOf
    canonOf(Module.update(Ast.emptyModule(), canon = Vector.fromList([0, 0])), 1) => 0
    canonOf(Ast.emptyModule(), 4) => 4

fn supersOf(m: Module, t: Int) -> List<Int>
    ? "The declared supertypes of type t."
    match Vector.get(m.types, t)
        Option.Some(st) -> st.supers
        Option.None -> []

fn supersReach(m: Module, ts: List<Int>, target: Int, fuel: Int) -> Bool
    ? "Whether any of ts reaches target."
    match fuel <= 0
        true -> false
        false -> supersReachList(m, ts, target, fuel)

fn supersReachList(m: Module, ts: List<Int>, target: Int, fuel: Int) -> Bool
    ? "Whether any of ts reaches target, with fuel left."
    match ts
        [] -> false
        [t, ..rest] -> Bool.or(isSub(m, t, target, fuel), supersReachList(m, rest, target, fuel))

verify isSub
    isSub(Ast.emptyModule(), 3, 3, 64) => true
    isSub(Ast.emptyModule(), 3, 4, 64) => false
    isSub(Module.update(Ast.emptyModule(), types = Vector.fromList([SubType(comp = Comp.ArrayT(ValType.I8), supers = [], final = false, group = 0, muts = []), SubType(comp = Comp.ArrayT(ValType.I8), supers = [0], final = true, group = 1, muts = [])])), 1, 0, 64) => true

fn refI31(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "ref.i31: the low 31 bits of an i32."
    match top(f, 1)
        [v, .._] -> go(x, put1(f, 1, Val.I31(Bits.low(Value.i32(v), 31))), calls, s)
        [] -> underflow(s)

fn i31Get(x: Inst, f: Frame, sg: Bool, calls: List<Frame>, s: Store) -> Next
    ? "i31.get_s and i31.get_u."
    match top(f, 1)
        [Val.I31(v), .._] -> go(x, put1(f, 1, Val.I32(i31Value(v, sg))), calls, s)
        _ -> trap("null i31 reference", s)

fn i31Value(v: Int, sg: Bool) -> Int
    ? "An i31 read signed or unsigned."
    match Bool.and(sg, v >= 1073741824)
        true -> v - 2147483648
        false -> v

verify i31Value
    i31Value(2147483647, true) => -1
    i31Value(2147483647, false) => 2147483647

// ---- structs and arrays ----

fn pack(t: ValType, v: Val) -> Val
    ? "A value as a field of storage type t keeps it: packed fields keep their low bits."
    match t
        ValType.I8 -> Val.I32(Bits.low(Value.i32(v), 8))
        ValType.I16 -> Val.I32(Bits.low(Value.i32(v), 16))
        _ -> v

verify pack
    pack(ValType.I8, Val.I32(-1)) => Val.I32(255)
    pack(ValType.I64, Val.I64(-1)) => Val.I64(-1)

fn unpack(t: ValType, v: Val, e: Int) -> Val
    ? "A packed field read signed (e = 1) or unsigned; other fields as they are."
    match t
        ValType.I8 -> Val.I32(extIf(Value.i32(v), 8, e))
        ValType.I16 -> Val.I32(extIf(Value.i32(v), 16, e))
        _ -> v

fn extIf(v: Int, bits: Int, e: Int) -> Int
    ? "v sign-extended from bits when e asks for it."
    match e == 1
        true -> Num.ext(v, bits)
        false -> v

verify unpack
    unpack(ValType.I8, Val.I32(255), 1) => Val.I32(-1)
    unpack(ValType.I8, Val.I32(255), 2) => Val.I32(255)

verify extIf
    extIf(32768, 16, 1) => -32768

fn packAll(fs: List<ValType>, vs: List<Val>, acc: List<Val>) -> List<Val>
    ? "Each value packed for its field."
    match fs
        [] -> List.reverse(acc)
        [t, ..ts] -> packAllNext(t, ts, vs, acc)

fn packAllNext(t: ValType, ts: List<ValType>, vs: List<Val>, acc: List<Val>) -> List<Val>
    ? "Packs the next value."
    match vs
        [] -> List.reverse(acc)
        [v, ..rest] -> packAll(ts, rest, List.prepend(pack(t, v), acc))

verify packAll
    packAll([ValType.I8, ValType.I32], [Val.I32(256), Val.I32(256)], []) => [Val.I32(0), Val.I32(256)]

verify packAllNext
    packAllNext(ValType.I8, [], [], []) => []

fn defaults(fs: List<ValType>, acc: List<Val>) -> List<Val>
    ? "The default value of each field."
    match fs
        [] -> List.reverse(acc)
        [t, ..rest] -> defaults(rest, List.prepend(Value.defaultOf(t), acc))

verify defaults
    defaults([ValType.I32, ValType.Ref(true, -18)], []) => [Val.I32(0), Val.Null]

fn alloc(x: Inst, f: Frame, popped: Int, o: Obj, arr: Option<Arr>, calls: List<Frame>, s: Store) -> Next
    ? "Puts a new object (and an array's elements) on the heap and pushes a reference to it, composting the heap first when it has grown past its threshold."
    match s.heap.live >= s.gcAt
        true -> place(x, f, popped, o, arr, calls, composted(roots(f, popped, o, arr, calls, s), s))
        false -> place(x, f, popped, o, arr, calls, s)

fn place(x: Inst, f: Frame, popped: Int, o: Obj, arr: Option<Arr>, calls: List<Frame>, s: Store) -> Next
    ? "Puts the object at the next address."
    a = Kompost.nextAddr(s.heap)
    go(x, put1(f, popped, Val.Ref(a)), calls, Store.update(s, heap = Kompost.allocAt(s.heap, a, o, arr)))

fn allocStruct(x: Inst, f: Frame, popped: Int, o: Obj, calls: List<Frame>, s: Store) -> Next
    ? "A new struct."
    alloc(x, f, popped, o, Option.None, calls, s)

fn allocArr(x: Inst, f: Frame, popped: Int, t: Int, arr: Arr, calls: List<Frame>, s: Store) -> Next
    ? "A new array of type t holding arr."
    alloc(x, f, popped, Obj.Array(x.base + t, Arr.len(arr)), Option.Some(arr), calls, s)

fn composted(rs: List<Val>, s: Store) -> Store
    ? "The store after a collection from the roots rs: the next one waits until the heap has doubled what survived. The heap goes to the collector moved, never shared."
    rethreshold(Store.update(s, heap = Kompost.collect(s.heap, rs)))

fn rethreshold(s: Store) -> Store
    ? "The collection threshold set from what survived."
    Store.update(s, gcAt = Int.max(2 * s.heap.live, 65536))

fn roots(f: Frame, popped: Int, o: Obj, arr: Option<Arr>, calls: List<Frame>, s: Store) -> List<Val>
    ? "Every value the program can still reach without the heap: the current frame's locals and live stack, the new object's fields or elements, every suspended frame, the values the host pinned (a machine suspended while the host calls back into the guest), the globals, tables and element segments."
    own = List.concat(s.pinned, List.concat(List.fromVector(f.locals), List.concat(stackVals(f, popped), newRefs(o, arr))))
    List.concat(own, List.concat(frameRoots(calls, []), List.concat(List.fromVector(s.globals), List.concat(flat(List.fromVector(s.tables), []), flat(List.fromVector(s.elems), [])))))

fn newRefs(o: Obj, arr: Option<Arr>) -> List<Val>
    ? "The values a new object holds."
    match o
        Obj.Array(_, _) -> arrayRefs(arr)
        _ -> Kompost.fieldsOf(o)

fn arrayRefs(arr: Option<Arr>) -> List<Val>
    ? "The elements of an array that may hold references; a packed one holds numbers."
    match arr
        Option.Some(Arr.Packed(_, _, _)) -> []
        Option.Some(e) -> Arr.toList(e)
        Option.None -> []

fn frameRoots(calls: List<Frame>, acc: List<Val>) -> List<Val>
    ? "The locals and live stacks of the suspended frames."
    match calls
        [] -> acc
        [c, ..rest] -> frameRoots(rest, List.concat(List.fromVector(c.locals), List.concat(stackVals(c, 0), acc)))

fn flat(vs: List<Vector<Val>>, acc: List<Val>) -> List<Val>
    ? "All values of a list of vectors."
    match vs
        [] -> acc
        [v, ..rest] -> flat(rest, List.concat(List.fromVector(v), acc))

verify flat
    flat([Vector.fromList([Val.Null]), Vector.fromList([Val.I32(1)])], []) => [Val.I32(1), Val.Null]

verify composted
    composted([], Store(globals = Vector.fromList([]), heap = Kompost.empty(), mem = {}, pages = 0, maxPages = 0, memAt = -1, others = {}, tables = Vector.fromList([]), elems = Vector.fromList([]), datas = Vector.fromList([]), gcAt = 0, pinned = [], steps = 0, mods = {})).gcAt => 65536

fn structNew(x: Inst, f: Frame, t: Int, dflt: Bool, calls: List<Frame>, s: Store) -> Next
    ? "struct.new and struct.new_default."
    fs = List.fromVector(Ast.structFields(x.m, t))
    n = List.len(fs)
    match dflt
        true -> allocStruct(x, f, 0, Kompost.mkStruct(x.base + t, defaults(fs, [])), calls, s)
        false -> allocStruct(x, f, n, Kompost.mkStruct(x.base + t, packAll(fs, List.reverse(top(f, n)), [])), calls, s)

fn structGet(x: Inst, f: Frame, t: Int, k: Int, e: Int, calls: List<Frame>, s: Store) -> Next
    ? "struct.get, struct.get_s and struct.get_u."
    match top(f, 1)
        [Val.Ref(a), .._] -> structField(x, f, Kompost.get(s.heap, a), t, k, e, 1, calls, s)
        _ -> trap("null structure reference", s)

fn structField(x: Inst, f: Frame, o: Obj, t: Int, k: Int, e: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Pushes field k of a struct."
    match o
        Obj.Free -> trap("not a struct", s)
        Obj.Array(_, _) -> trap("not a struct", s)
        _ -> go(x, put1(f, popped, fieldOf(x, o, t, k, e)), calls, s)

fn fieldType(x: Inst, t: Int, k: Int) -> ValType
    ? "The storage type of field k of struct type t."
    Option.withDefault(Vector.get(Ast.structFields(x.m, t), k), ValType.I32)

fn structSet(x: Inst, f: Frame, t: Int, k: Int, calls: List<Frame>, s: Store) -> Next
    ? "struct.set."
    match top(f, 2)
        [v, Val.Ref(a), .._] -> structWrite(x, f, a, k, pack(fieldType(x, t, k), v), 2, calls, s)
        _ -> trap("null structure reference", s)

fn structWrite(x: Inst, f: Frame, a: Int, k: Int, v: Val, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes field k of the struct at a: a new node with the field replaced goes into the slot. The store comes here once, so its heap is moved into the write."
    o = Kompost.get(s.heap, a)
    match o
        Obj.Free -> trap("not a struct", s)
        Obj.Array(_, _) -> trap("not a struct", s)
        _ -> go(x, putN(f, popped), calls, Store.update(s, heap = Kompost.put(s.heap, a, Kompost.withField(o, k, v))))

fn elemType(x: Inst, t: Int) -> ValType
    ? "The element type of array type t."
    Ast.arrayElem(x.m, t)

fn arrayNew(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.new: n copies of a value."
    match top(f, 2)
        [n, v, .._] -> match idx(n) > maxArray()
            true -> trap("allocation too large", s)
            false -> arrayOf(x, f, t, Arr.make(idx(n), pack(elemType(x, t), v), bitsOf(elemType(x, t))), 2, calls, s)
        _ -> underflow(s)

fn arrayNewDefault(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.new_default."
    match top(f, 1)
        [n, .._] -> match idx(n) > maxArray()
            true -> trap("allocation too large", s)
            false -> arrayOf(x, f, t, Arr.make(idx(n), Value.defaultOf(elemType(x, t)), bitsOf(elemType(x, t))), 1, calls, s)
        [] -> underflow(s)

fn maxArray() -> Int
    ? "The longest array Kompost makes (an implementation limit): 2^28 elements."
    268435456

verify maxArray
    maxArray() => 268435456

fn arrayOf(x: Inst, f: Frame, t: Int, r: Result<Arr, String>, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Allocates an array once its elements are made."
    match r
        Result.Ok(vs) -> allocArr(x, f, popped, t, vs, calls, s)
        Result.Err(e) -> trap("array too large: {e}", s)

fn arrayNewFixed(x: Inst, f: Frame, t: Int, n: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.new_fixed: the top n values, in push order."
    et = elemType(x, t)
    allocArr(x, f, n, t, Arr.fromList(packEach(et, List.reverse(top(f, n)), []), bitsOf(et)), calls, s)

fn packEach(t: ValType, vs: List<Val>, acc: List<Val>) -> List<Val>
    ? "Every value packed for one storage type."
    match vs
        [] -> List.reverse(acc)
        [v, ..rest] -> packEach(t, rest, List.prepend(pack(t, v), acc))

verify packEach
    packEach(ValType.I8, [Val.I32(257)], []) => [Val.I32(1)]

fn bitsOf(t: ValType) -> Int
    ? "The width an array of storage type t is packed at, or zero for unpacked."
    match t
        ValType.I8 -> 8
        ValType.I16 -> 16
        _ -> 0

verify bitsOf
    bitsOf(ValType.I8) => 8
    bitsOf(ValType.I16) => 16
    bitsOf(ValType.I32) => 0

fn elemSize(t: ValType) -> Int
    ? "The size in octets of a storage type in a data segment."
    match t
        ValType.I8 -> 1
        ValType.I16 -> 2
        ValType.I64 -> 8
        ValType.F64 -> 8
        _ -> 4

verify elemSize
    elemSize(ValType.I8) => 1
    elemSize(ValType.I16) => 2
    elemSize(ValType.I64) => 8
    elemSize(ValType.F64) => 8
    elemSize(ValType.I32) => 4

fn fromRaw(t: ValType, raw: Int) -> Val
    ? "A value of storage type t from its little-endian octets read as unsigned."
    match t
        ValType.I64 -> Val.I64(Num.wrap64(raw))
        ValType.F64 -> Num.f64Val(raw)
        ValType.F32 -> Num.f32Val(raw)
        ValType.I32 -> Val.I32(Num.wrap32(raw))
        _ -> Val.I32(raw)

verify fromRaw
    fromRaw(ValType.I32, 4294967295) => Val.I32(-1)
    fromRaw(ValType.I8, 255) => Val.I32(255)
    fromRaw(ValType.I64, 1) => Val.I64(1)
    fromRaw(ValType.F64, 4607182418800017408) => Val.F64(1.0)

fn dataVals(t: ValType, bytes: Vector<Int>, p: Int, n: Int, acc: List<Val>) -> List<Val>
    ? "n elements of type t read from octets at p."
    sz = elemSize(t)
    match n <= 0
        true -> List.reverse(acc)
        false -> dataVals(t, bytes, p + sz, n - 1, List.prepend(fromRaw(t, Bin.fixed(bytes, p, sz)), acc))

verify dataVals
    dataVals(ValType.I16, Vector.fromList([1, 0, 2, 0]), 0, 2, []) => [Val.I32(1), Val.I32(2)]

fn dataSeg(s: Store, d: Int) -> Vector<Int>
    ? "The octets of data segment d; a dropped one is empty."
    Option.withDefault(Vector.get(s.datas, d), Vector.fromList([]))

fn arrayNewData(x: Inst, f: Frame, t: Int, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.new_data: n elements from data segment d at an offset."
    match top(f, 2)
        [n, off, .._] -> arrayFromData(x, f, t, dataSeg(s, daddr(x, d)), idx(off), idx(n), 2, calls, s)
        _ -> underflow(s)

fn arrayFromData(x: Inst, f: Frame, t: Int, bytes: Vector<Int>, off: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Allocates an array read from octets, after the bounds check."
    et = elemType(x, t)
    match off + n * elemSize(et) > Vector.len(bytes)
        true -> trap("out of bounds memory access", s)
        false -> allocArr(x, f, popped, t, Arr.fromList(dataVals(et, bytes, off, n, []), bitsOf(et)), calls, s)

fn elemSeg(s: Store, e: Int) -> Vector<Val>
    ? "The values of element segment e; a dropped one is empty."
    Option.withDefault(Vector.get(s.elems, e), Vector.fromList([]))

fn dropSeg(es: Vector<Vector<Val>>, e: Int) -> Vector<Vector<Val>>
    ? "The element segments with e dropped."
    Option.withDefault(Vector.set(es, e, Vector.fromList([])), es)

fn slice(v: Vector<Val>, p: Int, n: Int) -> List<Val>
    ? "n values of v from p."
    List.take(List.drop(List.fromVector(v), p), n)

verify slice
    slice(Vector.fromList([Val.I32(1), Val.I32(2), Val.I32(3)]), 1, 1) => [Val.I32(2)]

fn arrayNewElem(x: Inst, f: Frame, t: Int, e: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.new_elem: n references from element segment e."
    match top(f, 2)
        [n, off, .._] -> arrayFromElem(x, f, t, elemSeg(s, eaddr(x, e)), idx(off), idx(n), 2, calls, s)
        _ -> underflow(s)

fn arrayFromElem(x: Inst, f: Frame, t: Int, seg: Vector<Val>, off: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Allocates an array from an element segment, after the bounds check."
    match off + n > Vector.len(seg)
        true -> trap("out of bounds table access", s)
        false -> allocArr(x, f, popped, t, Arr.fromList(slice(seg, off, n), 0), calls, s)

fn arrayGet(x: Inst, f: Frame, t: Int, e: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.get, array.get_s and array.get_u."
    match top(f, 2)
        [k, Val.Ref(a), .._] -> arrayElemAt(x, f, Kompost.arr(s.heap, a), idx(k), elemType(x, t), e, 2, calls, s)
        [_, Val.Null, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayElemAt(x: Inst, f: Frame, o: Option<Arr>, k: Int, et: ValType, e: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Pushes element k of an array."
    match o
        Option.Some(arr) -> arrayPushAt(x, f, Arr.get(arr, k), et, e, popped, calls, s)
        Option.None -> trap("not an array", s)

fn arrayPushAt(x: Inst, f: Frame, v: Option<Val>, et: ValType, e: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Pushes an element read in bounds, or traps."
    match v
        Option.Some(a) -> go(x, put1(f, popped, unpack(et, a, e)), calls, s)
        Option.None -> trap("out of bounds array access", s)

fn arraySet(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.set."
    match top(f, 3)
        [v, k, Val.Ref(a), .._] -> arrayWrite(x, f, a, idx(k), pack(elemType(x, t), v), 3, calls, s)
        [_, _, Val.Null, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayWrite(x: Inst, f: Frame, a: Int, k: Int, v: Val, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes element k of the array at a, in place."
    match k < arrLen(s, a)
        true -> go(x, putN(f, popped), calls, Store.update(s, heap = Kompost.setElem(s.heap, a, k, v)))
        false -> trap("out of bounds array access", s)

fn arrayLen(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "array.len."
    match top(f, 1)
        [Val.Ref(a), .._] -> go(x, put1(f, 1, Val.I32(arrLen(s, a))), calls, s)
        _ -> trap("null array reference", s)

fn arrayLength(o: Obj) -> Int
    ? "The length of an array object."
    match o
        Obj.Array(_, n) -> n
        _ -> 0

verify arrayLength
    arrayLength(Obj.Array(0, 1)) => 1
    arrayLength(Obj.Free) => 0

fn arrayTypeOf(o: Option<Obj>) -> Int
    ? "The type index of an array object."
    match o
        Option.Some(Obj.Array(t, _)) -> t
        _ -> 0

fn writeVals(v: Vector<Val>, k: Int, vs: List<Val>) -> Vector<Val>
    ? "v with vs written from slot k on."
    match vs
        [] -> v
        [a, ..rest] -> writeVals(vset(v, k, a), k + 1, rest)

verify writeVals
    writeVals(Vector.fromList([Val.Null, Val.Null]), 1, [Val.I32(5)]) => Vector.fromList([Val.Null, Val.I32(5)])

fn repeatVal(v: Val, n: Int, acc: List<Val>) -> List<Val>
    ? "n copies of v."
    match n <= 0
        true -> acc
        false -> repeatVal(v, n - 1, List.prepend(v, acc))

verify repeatVal
    repeatVal(Val.Null, 2, []) => [Val.Null, Val.Null]

fn arrayFill(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.fill."
    match top(f, 4)
        [n, v, k, Val.Ref(a), .._] -> arrayPut(x, f, a, idx(k), repeatVal(pack(elemType(x, t), v), idx(n), []), 4, calls, s)
        [_, _, _, Val.Null, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayPut(x: Inst, f: Frame, a: Int, k: Int, vs: List<Val>, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes vs into the array at a from slot k, after the bounds check, in place."
    match k + List.len(vs) > arrLen(s, a)
        true -> trap("out of bounds array access", s)
        false -> go(x, putN(f, popped), calls, Store.update(s, heap = Kompost.setElems(s.heap, a, k, vs)))

fn arrayCopy(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "array.copy: n elements from one array to another, which may be the same one."
    match top(f, 5)
        [n, si, Val.Ref(src), di, Val.Ref(dst), .._] -> arrayCopyIn(x, f, src, idx(si), dst, idx(di), idx(n), 5, calls, s)
        [_, _, _, _, _, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayCopyIn(x: Inst, f: Frame, src: Int, si: Int, dst: Int, di: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Copies after checking the source's bounds; arrayPut checks the destination's. The elements are read out first, so a copy within one array is right."
    match si + n > arrLen(s, src)
        true -> trap("out of bounds array access", s)
        false -> arrayPut(x, f, dst, di, Arr.slice(arrVals(s, src), si, n), popped, calls, s)

fn arrayInitData(x: Inst, f: Frame, t: Int, d: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.init_data."
    match top(f, 4)
        [n, so, k, Val.Ref(a), .._] -> arrayInitDataIn(x, f, a, t, dataSeg(s, daddr(x, d)), idx(so), idx(k), idx(n), 4, calls, s)
        [_, _, _, Val.Null, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayInitDataIn(x: Inst, f: Frame, a: Int, t: Int, bytes: Vector<Int>, so: Int, k: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes octets into an array after checking both bounds."
    et = elemType(x, t)
    len = arrayLength(Kompost.get(s.heap, a))
    match k + n > len
        true -> trap("out of bounds array access", s)
        false -> arrayInitDataRead(x, f, a, et, bytes, so, k, n, popped, calls, s)

fn arrayInitDataRead(x: Inst, f: Frame, a: Int, et: ValType, bytes: Vector<Int>, so: Int, k: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Reads the octets once the data segment's bounds hold."
    match so + n * elemSize(et) > Vector.len(bytes)
        true -> trap("out of bounds memory access", s)
        false -> arrayPut(x, f, a, k, dataVals(et, bytes, so, n, []), popped, calls, s)

fn arrayInitElem(x: Inst, f: Frame, e: Int, calls: List<Frame>, s: Store) -> Next
    ? "array.init_elem."
    match top(f, 4)
        [n, so, k, Val.Ref(a), .._] -> arrayInitElemIn(x, f, a, elemSeg(s, eaddr(x, e)), idx(so), idx(k), idx(n), 4, calls, s)
        [_, _, _, Val.Null, .._] -> trap("null array reference", s)
        _ -> underflow(s)

fn arrayInitElemIn(x: Inst, f: Frame, a: Int, seg: Vector<Val>, so: Int, k: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes references into an array after checking the segment's bounds."
    match so + n > Vector.len(seg)
        true -> trap("out of bounds table access", s)
        false -> arrayPut(x, f, a, k, slice(seg, so, n), popped, calls, s)

// ---- linear memory ----

fn withMem(x: Inst, s: Store, k: Int) -> Store
    ? "The store with memory k of instance x on top, where the code for memory 0 works on it. Memory 0 of the running instance is always on top, so it needs nothing."
    match k == 0
        true -> s
        false -> swapTo(s, maddr(x, k))

fn swapTo(s: Store, a: Int) -> Store
    ? "The store with the memory at address a on top, the one that was on top parked under its own address; memAt says which is on top."
    match a == s.memAt
        true -> s
        false -> match Map.get(s.others, a)
            Option.Some(o) -> Store.update(s, mem = o.mem, pages = o.pages, maxPages = o.maxPages, memAt = a, others = parked(Map.remove(s.others, a), s))
            Option.None -> s

fn parked(others: Map<Int, MemState>, s: Store) -> Map<Int, MemState>
    ? "others with the memory on top of s parked under its address, when there is one."
    match s.memAt >= 0
        true -> Map.set(others, s.memAt, MemState(mem = s.mem, pages = s.pages, maxPages = s.maxPages))
        false -> others

fn memBack(x: Inst, s: Store, k: Int) -> Store
    ? "After working on memory k, memory 0 of x goes back on top."
    match k == 0
        true -> s
        false -> swapTo(s, maddr(x, 0))

fn memAtOf(m: Module) -> Int
    ? "The address of the memory on top of a lone module's store: its memory 0, or -1 when it has none."
    match m.hasMemory
        true -> 0
        false -> -1

verify memBack
    memBack(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule()), 0) => emptyStore(Ast.emptyModule())

verify memAtOf
    memAtOf(Ast.emptyModule()) => -1

verify swapTo
    swapTo(emptyStore(Ast.emptyModule()), 2).pages => 0

verify parked
    Map.len(parked({}, emptyStore(Ast.emptyModule()))) => 0

verify withMem
    withMem(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Store.update(emptyStore(Ast.emptyModule()), others = {1 => MemState(mem = {}, pages = 3, maxPages = 4)}), 1).pages => 3
    memBack(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), withMem(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Store.update(emptyStore(Module.update(Ast.emptyModule(), hasMemory = true)), others = {1 => MemState(mem = {}, pages = 3, maxPages = 4)}), 1), 1).pages => 0

fn onMem(x: Inst, k: Int, n: Next) -> Next
    ? "Puts memory 0 of x back on top after an instruction ran on memory k."
    match k == 0
        true -> n
        false -> backMem(x, n)

fn backMem(x: Inst, n: Next) -> Next
    ? "Memory 0 of x back on top in the store a step goes on with."
    match n
        Next.Go(f, calls, s) -> Next.Go(f, calls, swapTo(s, maddr(x, 0)))
        Next.Out(o) -> Next.Out(outBack(x, o))

fn outBack(x: Inst, o: Outcome) -> Outcome
    ? "A trap or an exception carries its store: memory 0 of x goes back on top in it too."
    match o
        Outcome.Trap(e, s) -> Outcome.Trap(e, swapTo(s, maddr(x, 0)))
        Outcome.Thrown(t, vs, s) -> Outcome.Thrown(t, vs, swapTo(s, maddr(x, 0)))
        _ -> o

verify outBack
    outBack(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Outcome.Trap("x", emptyStore(Ast.emptyModule()))) => Outcome.Trap("x", emptyStore(Ast.emptyModule()))

verify onMem
    onMem(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 0, Next.Out(Outcome.Trap("x", emptyStore(Ast.emptyModule())))) => Next.Out(Outcome.Trap("x", emptyStore(Ast.emptyModule())))

verify backMem
    backMem(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Next.Out(Outcome.Trap("x", emptyStore(Ast.emptyModule())))) => Next.Out(Outcome.Trap("x", emptyStore(Ast.emptyModule())))

fn memorySize(x: Inst, f: Frame, wide: Bool, calls: List<Frame>, s: Store) -> Next
    ? "memory.size."
    go(x, push(f, sized(wide, s.pages)), calls, s)

fn memoryCopyIn(x: Inst, f: Frame, d: Int, src: Int, calls: List<Frame>, s: Store) -> Next
    ? "memory.copy from memory src to memory d."
    match d == src
        true -> onMem(x, d, memoryCopy(x, f, calls, withMem(x, s, d)))
        false -> memoryCopyAcross(x, f, d, src, calls, s)

fn memoryCopyAcross(x: Inst, f: Frame, dm: Int, sm: Int, calls: List<Frame>, s: Store) -> Next
    ? "memory.copy between two memories."
    match top(f, 3)
        [n, src, d, .._] -> copyAcross(x, f, dm, sm, idx(src), idx(d), idx(n), calls, withMem(x, s, sm))
        _ -> underflow(s)

fn copyAcross(x: Inst, f: Frame, dm: Int, sm: Int, src: Int, d: Int, n: Int, calls: List<Frame>, ss: Store) -> Next
    ? "Reads from memory sm (in the place of memory 0 in ss) after its bounds check, then writes into memory dm."
    match src + n > memBytes(ss)
        true -> trap("out of bounds memory access", memBack(x, ss, sm))
        false -> copyInto(x, f, dm, d, Mem.readList(ss.mem, src, n), n, calls, memBack(x, ss, sm))

fn copyInto(x: Inst, f: Frame, dm: Int, d: Int, bs: List<Int>, n: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes the copied octets into memory dm."
    onMem(x, dm, memWrite(x, f, d, bs, n, 3, calls, withMem(x, s, dm)))

fn idx(v: Val) -> Int
    ? "An address, index or count as an unsigned number: i64 for 64-bit memories and tables, i32 otherwise."
    match v
        Val.I64(n) -> Num.u64(n)
        _ -> Num.u32(Value.i32(v))

verify idx
    idx(Val.I32(-1)) => 4294967295
    idx(Val.I64(-1)) => 18446744073709551615

fn sized(wide: Bool, n: Int) -> Val
    ? "A size or grow result as an i64 for a 64-bit memory or table, else an i32."
    match wide
        true -> Val.I64(n)
        false -> Val.I32(n)

verify sized
    sized(true, -1) => Val.I64(-1)

fn memBytes(s: Store) -> Int
    ? "The size of linear memory in octets."
    s.pages * 65536

fn loadSize(op: Int) -> Int
    ? "How many octets a load reads."
    match op
        41 -> 8
        43 -> 8
        44 -> 1
        45 -> 1
        46 -> 2
        47 -> 2
        48 -> 1
        49 -> 1
        50 -> 2
        51 -> 2
        _ -> 4

verify loadSize
    loadSize(41) => 8
    loadSize(45) => 1
    loadSize(40) => 4

fn loadVal(op: Int, raw: Int) -> Val
    ? "The value a load pushes from the unsigned number its octets read as."
    match op
        40 -> Val.I32(Num.wrap32(raw))
        41 -> Val.I64(Num.wrap64(raw))
        42 -> Num.f32Val(raw)
        43 -> Num.f64Val(raw)
        44 -> Val.I32(Num.ext(raw, 8))
        46 -> Val.I32(Num.ext(raw, 16))
        48 -> Val.I64(Num.ext(raw, 8))
        49 -> Val.I64(raw)
        50 -> Val.I64(Num.ext(raw, 16))
        51 -> Val.I64(raw)
        52 -> Val.I64(Num.ext(raw, 32))
        53 -> Val.I64(raw)
        _ -> Val.I32(raw)

verify loadVal
    loadVal(44, 255) => Val.I32(-1)
    loadVal(45, 255) => Val.I32(255)
    loadVal(52, 4294967295) => Val.I64(-1)
    loadVal(42, 1065353216) => Val.F32(1.0)

fn load(x: Inst, f: Frame, op: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A load from linear memory."
    match top(f, 1)
        [a, .._] -> loadAt(x, f, op, idx(a) + off, 1, calls, s)
        [] -> underflow(s)

fn loadAt(x: Inst, f: Frame, op: Int, ea: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "A load from an effective address, after the bounds check."
    n = loadSize(op)
    match ea + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> go(x, put1(f, popped, loadVal(op, Mem.read(s.mem, ea, n))), calls, s)

fn storeSize(op: Int) -> Int
    ? "How many octets a store writes."
    match op
        55 -> 8
        57 -> 8
        58 -> 1
        59 -> 2
        60 -> 1
        61 -> 2
        _ -> 4

verify storeSize
    storeSize(55) => 8
    storeSize(58) => 1
    storeSize(54) => 4

fn storeBits(v: Val) -> Int
    ? "The integer whose low octets a store writes."
    match v
        Val.F64(_) -> Num.bits64(v)
        Val.NaN64(_) -> Num.bits64(v)
        Val.F32(_) -> Num.bits32(v)
        Val.NaN32(_) -> Num.bits32(v)
        _ -> Value.i32(v)

verify storeBits
    storeBits(Val.I32(-1)) => -1
    storeBits(Val.F64(1.0)) => 4607182418800017408
    storeBits(Val.F32(1.0)) => 1065353216

fn store(x: Inst, f: Frame, op: Int, off: Int, calls: List<Frame>, s: Store) -> Next
    ? "A store to linear memory."
    match top(f, 2)
        [v, a, .._] -> storeAt(x, f, op, idx(a) + off, v, 2, calls, s)
        _ -> underflow(s)

fn storeAt(x: Inst, f: Frame, op: Int, ea: Int, v: Val, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "A store to an effective address, after the bounds check."
    n = storeSize(op)
    match ea + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> go(x, putN(f, popped), calls, Store.update(s, mem = Mem.write(s.mem, ea, n, storeBits(v))))

fn memoryGrow(x: Inst, f: Frame, wide: Bool, calls: List<Frame>, s: Store) -> Next
    ? "memory.grow: the old size in pages, or -1 when the maximum would be passed."
    match top(f, 1)
        [d, .._] -> growBy(x, f, wide, idx(d), 1, calls, s)
        [] -> underflow(s)

fn growBy(x: Inst, f: Frame, wide: Bool, d: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Grows memory by d pages when it may."
    match s.pages + d > s.maxPages
        true -> go(x, put1(f, popped, sized(wide, -1)), calls, s)
        false -> go(x, put1(f, popped, sized(wide, s.pages)), calls, Store.update(s, pages = s.pages + d))

fn fillList(b: Int, n: Int, acc: List<Int>) -> List<Int>
    ? "n copies of the octet b."
    match n <= 0
        true -> acc
        false -> fillList(b, n - 1, List.prepend(b, acc))

verify fillList
    fillList(7, 2, []) => [7, 7]

fn memoryFill(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "memory.fill."
    match top(f, 3)
        [n, v, d, .._] -> memFill(x, f, idx(d), Bits.low(Value.i32(v), 8), idx(n), calls, s)
        _ -> underflow(s)

fn memFill(x: Inst, f: Frame, d: Int, b: Int, n: Int, calls: List<Frame>, s: Store) -> Next
    ? "Checks the bounds before the octets are made: a fill far out of bounds must trap, not build gigabytes first."
    match d + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> memWrite(x, f, d, fillList(b, n, []), n, 3, calls, s)

fn memWrite(x: Inst, f: Frame, d: Int, bs: List<Int>, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes n octets at d after the bounds check."
    match d + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> go(x, putN(f, popped), calls, Store.update(s, mem = Mem.writeList(s.mem, d, bs)))

fn memoryCopy(x: Inst, f: Frame, calls: List<Frame>, s: Store) -> Next
    ? "memory.copy, which may overlap."
    match top(f, 3)
        [n, src, d, .._] -> memCopyFrom(x, f, idx(src), idx(d), idx(n), 3, calls, s)
        _ -> underflow(s)

fn memCopyFrom(x: Inst, f: Frame, src: Int, d: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Reads the source after its bounds check, then writes."
    match src + n > memBytes(s)
        true -> trap("out of bounds memory access", s)
        false -> memWrite(x, f, d, Mem.readList(s.mem, src, n), n, popped, calls, s)

fn memoryInit(x: Inst, f: Frame, dI: Int, calls: List<Frame>, s: Store) -> Next
    ? "memory.init from a data segment."
    match top(f, 3)
        [n, src, d, .._] -> memInitFrom(x, f, dataSeg(s, daddr(x, dI)), idx(src), idx(d), idx(n), 3, calls, s)
        _ -> underflow(s)

fn memInitFrom(x: Inst, f: Frame, bytes: Vector<Int>, src: Int, d: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Reads the segment after its bounds check, then writes."
    match src + n > Vector.len(bytes)
        true -> trap("out of bounds memory access", s)
        false -> memWrite(x, f, d, Bin.octetsAt(bytes, src, n), n, popped, calls, s)

// ---- tables ----

fn table(s: Store, t: Int) -> Vector<Val>
    ? "Table t."
    Option.withDefault(Vector.get(s.tables, t), Vector.fromList([]))

fn setTable(s: Store, t: Int, v: Vector<Val>) -> Store
    ? "The store with table t replaced."
    Store.update(s, tables = Option.withDefault(Vector.set(s.tables, t, v), s.tables))

fn tableGet(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.get."
    match top(f, 1)
        [k, .._] -> tablePush(x, f, Vector.get(table(s, taddr(x, t)), idx(k)), 1, calls, s)
        [] -> underflow(s)

fn tablePush(x: Inst, f: Frame, v: Option<Val>, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Pushes a table entry read in bounds."
    match v
        Option.Some(a) -> go(x, put1(f, popped, a), calls, s)
        Option.None -> trap("out of bounds table access", s)

fn tableSet(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.set."
    match top(f, 2)
        [v, k, .._] -> tableWrite(x, f, t, idx(k), [v], 2, calls, s)
        _ -> underflow(s)

fn tableWrite(x: Inst, f: Frame, t: Int, k: Int, vs: List<Val>, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Writes vs into table t from k, after the bounds check."
    tb = table(s, taddr(x, t))
    match k + List.len(vs) > Vector.len(tb)
        true -> trap("out of bounds table access", s)
        false -> go(x, putN(f, popped), calls, setTable(s, taddr(x, t), writeVals(tb, k, vs)))

fn tableGrow(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.grow: the old size, or -1 past ten million entries."
    match top(f, 2)
        [n, v, .._] -> tableGrowBy(x, f, t, idx(n), v, 2, calls, s)
        _ -> underflow(s)

fn tableGrowBy(x: Inst, f: Frame, t: Int, n: Int, v: Val, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Grows table t by n copies of v when it may."
    tb = table(s, taddr(x, t))
    match Bool.or(Vector.len(tb) + n > 10000000, Vector.len(tb) + n > Ast.tableMax(x.m, t))
        true -> go(x, put1(f, popped, sized(Ast.tableIs64(x.m, t), -1)), calls, s)
        false -> go(x, put1(f, popped, sized(Ast.tableIs64(x.m, t), Vector.len(tb))), calls, setTable(s, taddr(x, t), Vector.fromList(List.concat(List.fromVector(tb), repeatVal(v, n, [])))))

fn tableFill(x: Inst, f: Frame, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.fill."
    match top(f, 3)
        [n, v, k, .._] -> match idx(k) + idx(n) > Vector.len(table(s, taddr(x, t)))
            true -> trap("out of bounds table access", s)
            false -> tableWrite(x, f, t, idx(k), repeatVal(v, idx(n), []), 3, calls, s)
        _ -> underflow(s)

fn tableCopy(x: Inst, f: Frame, d: Int, sr: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.copy."
    match top(f, 3)
        [n, so, k, .._] -> tableCopyFrom(x, f, d, table(s, taddr(x, sr)), idx(so), idx(k), idx(n), 3, calls, s)
        _ -> underflow(s)

fn tableCopyFrom(x: Inst, f: Frame, d: Int, src: Vector<Val>, so: Int, k: Int, n: Int, popped: Int, calls: List<Frame>, s: Store) -> Next
    ? "Copies after the source's bounds check."
    match so + n > Vector.len(src)
        true -> trap("out of bounds table access", s)
        false -> tableWrite(x, f, d, k, slice(src, so, n), popped, calls, s)

fn tableInit(x: Inst, f: Frame, e: Int, t: Int, calls: List<Frame>, s: Store) -> Next
    ? "table.init from an element segment."
    match top(f, 3)
        [n, so, k, .._] -> tableCopyFrom(x, f, t, elemSeg(s, eaddr(x, e)), idx(so), idx(k), idx(n), 3, calls, s)
        _ -> underflow(s)

// ---- instantiation and invocation ----

fn fuse(code: Vector<Instr>, ts: Vector<Label>) -> Vector<Instr>
    ? "The code with frequent runs fused: instruction i becomes one that does i and the next ones and steps over them, while they stay where they are, so every jump target keeps its meaning and a jump straight to i + 1 still runs it alone. An integer operation with its operands and its result (Op2) is tried first, then a triple, then a pair."
    Vector.fromList(fuseOps(List.fromVector(code), ts, []))

fn fuseOps(is: List<Instr>, ts: Vector<Label>, acc: List<Instr>) -> List<Instr>
    ? "Fuses each position: an Op2 run when one starts there, else as fuseList does."
    match is
        [] -> List.reverse(acc)
        [a, ..rest] -> fuseOps(rest, ts, List.prepend(fuseAt(a, is, ts), acc))

fn fuseAt(a: Instr, is: List<Instr>, ts: Vector<Label>) -> Instr
    ? "The instruction at the head of is, fused."
    match op2At(is, ts)
        Option.Some(o) -> o
        Option.None -> fuseRun(a, is, ts)

fn fuseRun(a: Instr, is: List<Instr>, ts: Vector<Label>) -> Instr
    ? "A fused run of locals and constants, else a triple or a pair."
    match is
        [Instr.LocalGet(x), Instr.LocalGet(y), Instr.ArrayGet(t, e), .._] -> Instr.ArrayGetLL(x, y, t, e)
        [Instr.RefNull(_), Instr.LocalSet(x), Instr.RefNull(_), Instr.LocalSet(y), .._] -> Instr.NullTo2(x, y)
        [Instr.I64Const(k), Instr.LocalSet(x), .._] -> Instr.ConstTo(x, k, true)
        [Instr.I32Const(k), Instr.LocalSet(x), .._] -> Instr.ConstTo(x, k, false)
        [Instr.LocalGet(x), Instr.BrOnNull(t), .._] -> Instr.GetBrOnNull(x, t)
        _ -> firstFused(fuseList(List.take(is, 3), []), a)

verify fuseRun
    fuseRun(Instr.Nop, [Instr.LocalGet(1), Instr.LocalGet(2), Instr.ArrayGet(3, 0)], Vector.fromList([])) => Instr.ArrayGetLL(1, 2, 3, 0)
    fuseRun(Instr.Nop, [Instr.RefNull(-16), Instr.LocalSet(1), Instr.RefNull(-16), Instr.LocalSet(2)], Vector.fromList([])) => Instr.NullTo2(1, 2)
    fuseRun(Instr.Nop, [Instr.I64Const(5), Instr.LocalSet(1)], Vector.fromList([])) => Instr.ConstTo(1, 5, true)
    fuseRun(Instr.Nop, [Instr.LocalGet(1), Instr.BrOnNull(0)], Vector.fromList([])) => Instr.GetBrOnNull(1, 0)
    fuseRun(Instr.Nop, [Instr.Nop], Vector.fromList([])) => Instr.Nop

fn firstFused(xs: List<Instr>, a: Instr) -> Instr
    ? "The first of a fused list."
    match xs
        [x, .._] -> x
        [] -> a

fn op2At(is: List<Instr>, ts: Vector<Label>) -> Option<Instr>
    ? "An Op2 for a run of local.get / const operands, a hot integer operation and an optional consumer (local.set, br_if inside the function, a resolved if); None when no such run starts here or it would replace a lone operation."
    match is
        [Instr.LocalGet(a), Instr.LocalGet(b), Instr.Bin(op), ..rest] -> op2Then(op, a, b, 0, 3, rest, ts)
        [Instr.LocalGet(a), Instr.I32Const(k), Instr.Bin(op), ..rest] -> op2Then(op, a, -2, k, 3, rest, ts)
        [Instr.LocalGet(a), Instr.I64Const(k), Instr.Bin(op), ..rest] -> op2Then(op, a, -2, k, 3, rest, ts)
        [Instr.I32Const(k), Instr.Bin(op), ..rest] -> op2Then(op, -1, -2, k, 2, rest, ts)
        [Instr.I64Const(k), Instr.Bin(op), ..rest] -> op2Then(op, -1, -2, k, 2, rest, ts)
        [Instr.LocalGet(b), Instr.Bin(op), ..rest] -> op2Then(op, -1, b, 0, 2, rest, ts)
        [Instr.Bin(op), c, .._] -> op2Lone(op, c, ts)
        _ -> Option.None

fn op2Then(op: Int, a: Int, b: Int, k: Int, sk: Int, rest: List<Instr>, ts: Vector<Label>) -> Option<Instr>
    ? "The Op2 for operands a, b (or k) and what consumes the result."
    match hotOp(op)
        true -> Option.Some(op2With(op, a, b, k, sk, consumer(rest, ts)))
        false -> Option.None

fn op2Lone(op: Int, c: Instr, ts: Vector<Label>) -> Option<Instr>
    ? "An operation on the stack fused only with a consumer after it."
    match Bool.and(hotOp(op), consumerOf(c, ts) > 0)
        true -> Option.Some(op2With(op, -1, -1, 0, 1, consumer([c], ts)))
        false -> Option.None

fn op2With(op: Int, a: Int, b: Int, k: Int, sk: Int, c: Instr) -> Instr
    ? "The Op2 with its consumer c, Nop meaning the result is pushed."
    match c
        Instr.LocalSet(d) -> Instr.Op2(op, a, b, k, 1, d, sk + 1)
        Instr.BrIf(t) -> Instr.Op2(op, a, b, k, 2, t, sk + 1)
        Instr.IfNot(t) -> Instr.Op2(op, a, b, k, 3, t, sk + 1)
        Instr.JumpIf(t) -> Instr.Op2(op, a, b, k, 4, t, sk + 1)
        _ -> Instr.Op2(op, a, b, k, 0, 0, sk)

fn consumer(rest: List<Instr>, ts: Vector<Label>) -> Instr
    ? "The instruction after the operation when it can take the result in place, else Nop."
    match rest
        [c, .._] -> pickInstr(consumerOf(c, ts) > 0, c)
        [] -> Instr.Nop

fn pickInstr(ok: Bool, c: Instr) -> Instr
    ? "c when ok, else Nop."
    match ok
        true -> c
        false -> Instr.Nop

fn consumerOf(c: Instr, ts: Vector<Label>) -> Int
    ? "1 when c can take a result in place: local.set, a resolved if, or br_if to a target inside the function."
    match c
        Instr.LocalSet(_) -> 1
        Instr.IfNot(_) -> 1
        Instr.JumpIf(_) -> 1
        Instr.BrIf(t) -> insideCount(insideAt(ts, t))
        _ -> 0

fn insideCount(o: Option<Label>) -> Int
    ? "1 for a target, 0 for none."
    match o
        Option.Some(_) -> 1
        Option.None -> 0

verify insideCount
    insideCount(Option.None) => 0

fn insideAt(ts: Vector<Label>, t: Int) -> Option<Label>
    ? "Target t when it stays inside the function."
    match Vector.get(ts, t)
        Option.Some(l) -> inside(l)
        Option.None -> Option.None

fn hotOp(op: Int) -> Bool
    ? "The integer operations that cannot trap, which Op2 does."
    Bool.or(Bool.or(Bool.and(op >= 106, op <= 108), Bool.and(op >= 113, op <= 120)), Bool.or(Bool.or(Bool.and(op >= 70, op <= 79), Bool.and(op >= 81, op <= 90)), Bool.or(Bool.and(op >= 124, op <= 126), Bool.and(op >= 131, op <= 138))))

verify fuseOps
    fuseOps([Instr.LocalGet(0), Instr.LocalGet(1), Instr.Bin(106), Instr.LocalSet(2)], Vector.fromList([]), []) => [Instr.Op2(106, 0, 1, 0, 1, 2, 4), Instr.Op2(106, -1, 1, 0, 1, 2, 3), Instr.Op2(106, -1, -1, 0, 1, 2, 2), Instr.LocalSet(2)]

verify fuseAt
    fuseAt(Instr.Nop, [Instr.Nop], Vector.fromList([])) => Instr.Nop

verify firstFused
    firstFused([], Instr.Nop) => Instr.Nop

verify op2At
    op2At([Instr.I64Const(3), Instr.Bin(83), Instr.BrIf(0)], Vector.fromList([Label(cont = 5, arity = 0, base = 0)])) => Option.Some(Instr.Op2(83, -1, -2, 3, 2, 0, 3))
    op2At([Instr.Bin(106), Instr.Nop], Vector.fromList([])) => Option.None
    op2At([Instr.LocalGet(0), Instr.LocalGet(1), Instr.Bin(109)], Vector.fromList([])) => Option.None

verify op2Then
    op2Then(106, 0, 1, 0, 3, [], Vector.fromList([])) => Option.Some(Instr.Op2(106, 0, 1, 0, 0, 0, 3))

verify op2Lone
    op2Lone(106, Instr.LocalSet(1), Vector.fromList([])) => Option.Some(Instr.Op2(106, -1, -1, 0, 1, 1, 2))

verify op2With
    op2With(106, 0, 1, 0, 3, Instr.Nop) => Instr.Op2(106, 0, 1, 0, 0, 0, 3)

verify consumer
    consumer([Instr.BrIf(0)], Vector.fromList([Label(cont = -1, arity = 0, base = 0)])) => Instr.Nop

verify pickInstr
    pickInstr(false, Instr.Drop) => Instr.Nop

verify consumerOf
    consumerOf(Instr.Drop, Vector.fromList([])) => 0

verify insideAt
    insideAt(Vector.fromList([]), 0) => Option.None

verify hotOp
    hotOp(109) => false
    hotOp(137) => true

fn fuseList(is: List<Instr>, acc: List<Instr>) -> List<Instr>
    ? "Fuses each instruction with the original ones after it: a frequent triple first, else a frequent pair."
    match is
        [] -> List.reverse(acc)
        [a] -> List.reverse(List.prepend(a, acc))
        [a, b] -> List.reverse(List.prepend(b, List.prepend(fusePair(a, b), acc)))
        [a, b, c, ..rest] -> fuseList(List.prepend(b, List.prepend(c, rest)), List.prepend(fuseTriple(a, b, c), acc))

fn fuseTriple(a: Instr, b: Instr, c: Instr) -> Instr
    ? "a fused with b and c when the three are one of the frequent triples, else with b alone."
    match a
        Instr.LocalGet(k) -> fuseGet3(k, b, c)
        _ -> fusePair(a, b)

fn fuseGet3(k: Int, b: Instr, c: Instr) -> Instr
    ? "local.get k followed by b and c."
    match b
        Instr.StructGet(t, fld, e) -> fieldTo(k, t, fld, e, c)
        Instr.RefCast(nl, h) -> castThen(k, nl, h, c)
        Instr.RefTest(nl, h) -> testThen(k, nl, h, c)
        Instr.RefIsNull -> isNullThen(k, c)
        _ -> fuseGet(k, b)

fn fieldTo(k: Int, t: Int, fld: Int, e: Int, c: Instr) -> Instr
    ? "local.get k, struct.get, then c."
    match c
        Instr.LocalSet(j) -> Instr.FieldTo(k, t, fld, e, j)
        _ -> Instr.GetField(k, t, fld, e)

fn castThen(k: Int, nl: Bool, h: Int, c: Instr) -> Instr
    ? "local.get k, ref.cast, then c."
    match c
        Instr.StructGet(t, fld, e) -> Instr.CastField(k, nl, h, t, fld, e)
        _ -> Instr.LocalGet(k)

fn testThen(k: Int, nl: Bool, h: Int, c: Instr) -> Instr
    ? "local.get k, ref.test, then c."
    match c
        Instr.IfNot(t) -> Instr.GetTestIfNot(k, nl, h, t)
        _ -> Instr.LocalGet(k)

fn isNullThen(k: Int, c: Instr) -> Instr
    ? "local.get k, ref.is_null, then c."
    match c
        Instr.IfNot(t) -> Instr.GetIsNullIfNot(k, t)
        _ -> Instr.GetIsNull(k)

verify fuseTriple
    fuseTriple(Instr.LocalGet(1), Instr.StructGet(2, 3, 0), Instr.LocalSet(4)) => Instr.FieldTo(1, 2, 3, 0, 4)
    fuseTriple(Instr.Nop, Instr.Nop, Instr.Nop) => Instr.Nop

verify fuseGet3
    fuseGet3(1, Instr.RefCast(true, 5), Instr.StructGet(5, 0, 0)) => Instr.CastField(1, true, 5, 5, 0, 0)
    fuseGet3(1, Instr.RefTest(false, 5), Instr.IfNot(9)) => Instr.GetTestIfNot(1, false, 5, 9)
    fuseGet3(1, Instr.RefIsNull, Instr.IfNot(9)) => Instr.GetIsNullIfNot(1, 9)
    fuseGet3(1, Instr.LocalGet(2), Instr.Nop) => Instr.GetGet(1, 2)

verify fieldTo
    fieldTo(1, 2, 3, 0, Instr.Nop) => Instr.GetField(1, 2, 3, 0)

verify castThen
    castThen(1, true, 2, Instr.Nop) => Instr.LocalGet(1)

verify testThen
    testThen(1, true, 2, Instr.Nop) => Instr.LocalGet(1)

verify isNullThen
    isNullThen(1, Instr.Nop) => Instr.GetIsNull(1)

fn fusePair(a: Instr, b: Instr) -> Instr
    ? "a fused with b when the pair is one of the frequent ones, else a."
    match a
        Instr.LocalGet(k) -> fuseGet(k, b)
        Instr.LocalSet(k) -> fuseSet(k, b)
        Instr.RefIsNull -> fuseIsNull(b)
        Instr.RefNull(_) -> fuseNull(a, b)
        Instr.RefTest(nl, h) -> fuseTest(nl, h, b)
        _ -> a

fn fuseNull(a: Instr, b: Instr) -> Instr
    ? "ref.null followed by b."
    match b
        Instr.LocalSet(j) -> Instr.NullTo(j)
        _ -> a

fn fuseTest(nl: Bool, h: Int, b: Instr) -> Instr
    ? "ref.test followed by b."
    match b
        Instr.IfNot(t) -> Instr.TestIfNot(nl, h, t)
        _ -> Instr.RefTest(nl, h)

verify fuseNull
    fuseNull(Instr.RefNull(-16), Instr.LocalSet(2)) => Instr.NullTo(2)
    fuseNull(Instr.RefNull(-16), Instr.Nop) => Instr.RefNull(-16)

verify fuseTest
    fuseTest(true, 3, Instr.IfNot(7)) => Instr.TestIfNot(true, 3, 7)
    fuseTest(true, 3, Instr.Nop) => Instr.RefTest(true, 3)

fn fuseGet(k: Int, b: Instr) -> Instr
    ? "local.get k followed by b."
    match b
        Instr.LocalGet(j) -> Instr.GetGet(k, j)
        Instr.LocalSet(j) -> Instr.Copy(k, j)
        Instr.I32Const(c) -> Instr.GetConst(k, c)
        Instr.StructGet(t, fld, e) -> Instr.GetField(k, t, fld, e)
        Instr.RefIsNull -> Instr.GetIsNull(k)
        _ -> Instr.LocalGet(k)

fn fuseSet(k: Int, b: Instr) -> Instr
    ? "local.set k followed by b."
    match b
        Instr.LocalGet(j) -> Instr.SetGet(k, j)
        _ -> Instr.LocalSet(k)

fn fuseIsNull(b: Instr) -> Instr
    ? "ref.is_null followed by b."
    match b
        Instr.IfNot(t) -> Instr.IsNullIfNot(t)
        _ -> Instr.RefIsNull

verify fuseList
    fuseList([Instr.LocalGet(0), Instr.LocalGet(1), Instr.LocalGet(2)], []) => [Instr.GetGet(0, 1), Instr.GetGet(1, 2), Instr.LocalGet(2)]
    fuseList([], []) => []

verify fusePair
    fusePair(Instr.Nop, Instr.Nop) => Instr.Nop

verify fuseGet
    fuseGet(3, Instr.I32Const(7)) => Instr.GetConst(3, 7)
    fuseGet(3, Instr.StructGet(1, 2, 0)) => Instr.GetField(3, 1, 2, 0)
    fuseGet(3, Instr.RefIsNull) => Instr.GetIsNull(3)
    fuseGet(3, Instr.Nop) => Instr.LocalGet(3)

verify fuseSet
    fuseSet(1, Instr.LocalGet(2)) => Instr.SetGet(1, 2)
    fuseSet(1, Instr.Nop) => Instr.LocalSet(1)

verify fuseIsNull
    fuseIsNull(Instr.Nop) => Instr.RefIsNull

fn buildFns(m: Module, fs: List<Func>, shapes: List<Shape>, acc: List<Fn>) -> List<Fn>
    ? "The run-time view of every function: resolved code, default locals, arity and stack size."
    match fs
        [] -> List.reverse(acc)
        [fd, ..rest] -> buildFns(m, rest, List.drop(shapes, 1), List.prepend(fnOf(m, fd, firstShape(shapes)), acc))

fn firstShape(shapes: List<Shape>) -> Shape
    ? "The first shape of a list, an empty one when none is known."
    match shapes
        [sh, .._] -> sh
        [] -> Shape(maxH = 0, heights = Vector.fromList([]))

fn codeOf(fd: Func) -> Vector<Instr>
    ? "A function's code, empty for an import."
    match fd
        Func.Imported(_, _, _) -> Vector.fromList([])
        Func.Local(_, _, code) -> code

fn fnOf(m: Module, fd: Func, sh: Shape) -> Fn
    ? "The run-time view of one function, from what validation learnt of its body."
    match fd
        Func.Imported(md, nm, t) -> Fn(code = Vector.fromList([]), targets = Vector.fromList([]), defaults = Vector.fromList([]), params = List.len(Ast.funcParams(m, t)), results = List.len(Ast.funcResults(m, t)), imported = true, mod = md, name = nm, ty = t, cap = 0)
        Func.Local(t, ls, code) -> localFn(m, t, ls, resolve(code, sh.heights, List.len(Ast.funcResults(m, t))), Int.max(sh.maxH, 1))

fn localFn(m: Module, t: Int, ls: Vector<ValType>, r: Resolved, cap: Int) -> Fn
    ? "A local function from its resolved code."
    Fn(code = fuse(r.code, r.targets), targets = r.targets, defaults = Vector.fromList(defaults(List.fromVector(ls), [])), params = List.len(Ast.funcParams(m, t)), results = List.len(Ast.funcResults(m, t)), imported = false, mod = "", name = "", ty = t, cap = cap)

verify fnOf
    fnOf(Ast.emptyModule(), Func.Imported("aver", "p", 0), Shape(maxH = 0, heights = Vector.fromList([]))).imported => true

verify localFn
    localFn(Ast.emptyModule(), 0, Vector.fromList([]), Resolved(code = Vector.fromList([Instr.Nop]), targets = Vector.fromList([])), 1).code => Vector.fromList([Instr.Nop])

// ---- resolving structured control ----

record Resolved
    code: Vector<Instr>
    targets: Vector<Label>

record Rs
    code: Vector<Instr>
    hs: Vector<Int>
    nps: Vector<Int>
    results: Int
    last: Int

fn resolve(code: Vector<Instr>, hs: Vector<Int>, results: Int) -> Resolved
    ? "Validated code with its structured control resolved: block, loop and every end but the last are dropped; an if becomes IfNot to the start of its false arm, an else a Jump past the if's end; every branch indexes a target holding the new program counter it continues at (-1 for the function's own label, which returns), the values it carries and the stack height beneath them, from validation's heights. nps maps every old program counter to the new one."
    last = Vector.len(code) - 1
    rs = Rs(code = code, hs = hs, nps = Vector.fromList(newPcs(code, last, 0, 0, [])), results = results, last = last)
    withHandlers(resolveFrom(rs, 0, [], [], [], 0), handlersFrom(rs, 0, [], []))

record Hc
    from: Int
    to: Int
    kind: Int
    tag: Int
    l: Label

fn withHandlers(r: Resolved, hcs: List<Hc>) -> Resolved
    ? "The resolved code with a Handler for each catch clause after its last end, and the clauses' targets after the others."
    match hcs
        [] -> r
        _ -> Resolved(code = Vector.fromList(List.concat(List.fromVector(r.code), handlerInstrs(hcs, Vector.len(r.targets), []))), targets = Vector.fromList(List.concat(List.fromVector(r.targets), labelsOf(hcs, []))))

fn handlerInstrs(hcs: List<Hc>, k: Int, acc: List<Instr>) -> List<Instr>
    ? "A Handler per clause, its target numbered from k."
    match hcs
        [] -> List.reverse(acc)
        [h, ..rest] -> handlerInstrs(rest, k + 1, List.prepend(Instr.Handler(h.from, h.to, h.kind, h.tag, k), acc))

fn labelsOf(hcs: List<Hc>, acc: List<Label>) -> List<Label>
    ? "The clauses' targets, in order."
    match hcs
        [] -> List.reverse(acc)
        [h, ..rest] -> labelsOf(rest, List.prepend(h.l, acc))

fn handlersFrom(rs: Rs, pc: Int, labels: List<Label>, acc: List<Hc>) -> List<Hc>
    ? "The catch clauses of the code from pc on, with the labels open there as resolve keeps them. They come out so that reading them back to front gives the innermost try_table first and each one's clauses in order."
    match Vector.get(rs.code, pc)
        Option.None -> List.reverse(acc)
        Option.Some(i) -> handlersOne(rs, pc, i, intAt(rs.hs, pc), labels, acc)

fn handlersOne(rs: Rs, pc: Int, i: Instr, h: Int, labels: List<Label>, acc: List<Hc>) -> List<Hc>
    ? "Opens or closes a label for i, and records a try_table's clauses against the labels outside it."
    match i
        Instr.Block(a, np, end, _) -> handlersFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - np), labels), acc)
        Instr.Loop(np, _) -> handlersFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, pc), arity = np, base = h - np), labels), acc)
        Instr.If(a, np, _, end, _) -> handlersFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - 1 - np), labels), acc)
        Instr.TryTable(a, np, end, _, cs) -> handlersFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - np), labels), clauses(rs, List.reverse(triples(List.fromVector(cs), [])), intAt(rs.nps, pc), intAt(rs.nps, end), labels, acc))
        Instr.End -> handlersFrom(rs, pc + 1, List.drop(labels, 1), acc)
        _ -> handlersFrom(rs, pc + 1, labels, acc)

fn triples(cs: List<Int>, acc: List<List<Int>>) -> List<List<Int>>
    ? "Flat clauses as triples of kind, tag and label."
    match cs
        [k, t, l, ..rest] -> triples(rest, List.prepend([k, t, l], acc))
        _ -> List.reverse(acc)

fn clauses(rs: Rs, cs: List<List<Int>>, from: Int, to: Int, labels: List<Label>, acc: List<Hc>) -> List<Hc>
    ? "Records clauses, given last first."
    match cs
        [c, ..rest] -> clauses(rs, rest, from, to, labels, List.prepend(clauseOf(rs, c, from, to, labels), acc))
        [] -> acc

fn clauseOf(rs: Rs, c: List<Int>, from: Int, to: Int, labels: List<Label>) -> Hc
    ? "One clause with its target."
    match c
        [k, t, l] -> Hc(from = from, to = to, kind = k, tag = t, l = targetOf(labels, l, rs.results))
        _ -> Hc(from = from, to = to, kind = 2, tag = -1, l = targetOf(labels, 0, rs.results))

verify withHandlers
    withHandlers(Resolved(code = Vector.fromList([Instr.End]), targets = Vector.fromList([])), []) => Resolved(code = Vector.fromList([Instr.End]), targets = Vector.fromList([]))

verify handlerInstrs
    handlerInstrs([Hc(from = 0, to = 2, kind = 0, tag = 1, l = Label(cont = 3, arity = 1, base = 0))], 4, []) => [Instr.Handler(0, 2, 0, 1, 4)]

verify labelsOf
    labelsOf([Hc(from = 0, to = 2, kind = 0, tag = 1, l = Label(cont = 3, arity = 1, base = 0))], []) => [Label(cont = 3, arity = 1, base = 0)]

verify handlersFrom
    handlersFrom(Rs(code = Vector.fromList([Instr.Block(0, 0, 4, Sig(params = [], results = [], ty = -1)), Instr.TryTable(0, 0, 3, Sig(params = [], results = [], ty = -1), Vector.fromList([2, -1, 0])), Instr.Throw(0), Instr.End, Instr.End, Instr.End]), hs = Vector.fromList([0, 0, 0, 0, 0, 0]), nps = Vector.fromList([0, 0, 0, 1, 1, 1, 2]), results = 0, last = 5), 0, [], []) => [Hc(from = 0, to = 1, kind = 2, tag = -1, l = Label(cont = 1, arity = 0, base = 0))]

verify handlersOne
    handlersOne(Rs(code = Vector.fromList([]), hs = Vector.fromList([]), nps = Vector.fromList([]), results = 0, last = 0), 0, Instr.Nop, 0, [], []) => []

verify triples
    triples([0, 1, 2, 3, -1, 4], []) => [[0, 1, 2], [3, -1, 4]]

verify clauses
    clauses(Rs(code = Vector.fromList([]), hs = Vector.fromList([]), nps = Vector.fromList([]), results = 1, last = 0), [[3, -1, 0]], 1, 2, [], []) => [Hc(from = 1, to = 2, kind = 3, tag = -1, l = Label(cont = -1, arity = 1, base = 0))]

verify clauseOf
    clauseOf(Rs(code = Vector.fromList([]), hs = Vector.fromList([]), nps = Vector.fromList([]), results = 0, last = 0), [], 0, 1, []).kind => 2

fn newPcs(code: Vector<Instr>, last: Int, pc: Int, kept: Int, acc: List<Int>) -> List<Int>
    ? "For each old program counter, and one past the end, how many kept instructions come before it."
    match Vector.get(code, pc)
        Option.None -> List.reverse(List.prepend(kept, acc))
        Option.Some(i) -> newPcs(code, last, pc + 1, kept + keptOf(i, pc == last), List.prepend(kept, acc))

fn keptOf(i: Instr, isLast: Bool) -> Int
    ? "1 when the instruction stays in resolved code, 0 when it is dropped."
    match i
        Instr.Block(_, _, _, _) -> 0
        Instr.Loop(_, _) -> 0
        Instr.TryTable(_, _, _, _, _) -> 0
        Instr.End -> pickPc(isLast, 1, 0)
        _ -> 1

fn intAt(v: Vector<Int>, k: Int) -> Int
    ? "Slot k of v, 0 out of range."
    Option.withDefault(Vector.get(v, k), 0)

fn resolveFrom(rs: Rs, pc: Int, labels: List<Label>, out: List<Instr>, ts: List<Label>, nt: Int) -> Resolved
    ? "Resolves from pc on; labels are the open blocks' targets, the innermost first; out and ts collect code and targets in reverse; nt counts the targets."
    match Vector.get(rs.code, pc)
        Option.None -> Resolved(code = Vector.fromList(List.reverse(out)), targets = Vector.fromList(List.reverse(ts)))
        Option.Some(i) -> resolveOne(rs, pc, i, intAt(rs.hs, pc), labels, out, ts, nt)

fn resolveOne(rs: Rs, pc: Int, i: Instr, h: Int, labels: List<Label>, out: List<Instr>, ts: List<Label>, nt: Int) -> Resolved
    ? "Resolves instruction i at pc, h being the stack height before it."
    match i
        Instr.Block(a, np, end, _) -> resolveFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - np), labels), out, ts, nt)
        Instr.Loop(np, _) -> resolveFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, pc), arity = np, base = h - np), labels), out, ts, nt)
        Instr.TryTable(a, np, end, _, _) -> resolveFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - np), labels), out, ts, nt)
        Instr.If(a, np, els, end, _) -> resolveFrom(rs, pc + 1, List.prepend(Label(cont = intAt(rs.nps, end), arity = a, base = h - 1 - np), labels), List.prepend(Instr.IfNot(falseArm(rs.nps, els, end)), out), ts, nt)
        Instr.Else -> resolveFrom(rs, pc + 1, labels, List.prepend(Instr.Jump(innerCont(labels)), out), ts, nt)
        Instr.End -> resolveEnd(rs, pc, labels, out, ts, nt)
        Instr.BrTable(ls, d) -> resolveFrom(rs, pc + 1, labels, List.prepend(Instr.BrTable(Vector.fromList(countFrom(nt, Vector.len(ls), [])), nt + Vector.len(ls)), out), List.prepend(targetOf(labels, d, rs.results), addTargets(List.fromVector(ls), labels, rs.results, ts)), nt + Vector.len(ls) + 1)
        Instr.Br(d) -> resolveBr(rs, pc, i, labels, out, ts, nt, targetOf(labels, d, rs.results), h, 0)
        Instr.BrIf(d) -> resolveBr(rs, pc, i, labels, out, ts, nt, targetOf(labels, d, rs.results), h, 1)
        _ -> resolveBranch(rs, pc, i, labels, out, ts, nt, depthOf(i))

fn resolveEnd(rs: Rs, pc: Int, labels: List<Label>, out: List<Instr>, ts: List<Label>, nt: Int) -> Resolved
    ? "The last end stays and returns; any other closes the innermost block and is dropped."
    match pc == rs.last
        true -> resolveFrom(rs, pc + 1, labels, List.prepend(Instr.End, out), ts, nt)
        false -> resolveFrom(rs, pc + 1, List.drop(labels, 1), out, ts, nt)

fn resolveBr(rs: Rs, pc: Int, i: Instr, labels: List<Label>, out: List<Instr>, ts: List<Label>, nt: Int, l: Label, h: Int, pops: Int) -> Resolved
    ? "br and br_if to a target inside the function that moves no values (the height after the condition is the target's base plus its values) become Jump and JumpIf; any other gets a target."
    match Bool.and(l.cont >= 0, h - pops - l.arity == l.base)
        true -> resolveFrom(rs, pc + 1, labels, List.prepend(plainJump(l.cont, pops), out), ts, nt)
        false -> resolveFrom(rs, pc + 1, labels, List.prepend(withTarget(i, nt), out), List.prepend(l, ts), nt + 1)

fn plainJump(t: Int, pops: Int) -> Instr
    ? "Jump for br, JumpIf for br_if."
    match pops == 0
        true -> Instr.Jump(t)
        false -> Instr.JumpIf(t)

verify resolveBr
    resolveBr(Rs(code = Vector.fromList([Instr.Br(0)]), hs = Vector.fromList([0]), nps = Vector.fromList([0, 1]), results = 0, last = 0), 0, Instr.Br(0), [], [], [], 0, Label(cont = 4, arity = 0, base = 0), 0, 0).code => Vector.fromList([Instr.Jump(4)])
    resolveBr(Rs(code = Vector.fromList([Instr.BrIf(0)]), hs = Vector.fromList([2]), nps = Vector.fromList([0, 1]), results = 0, last = 0), 0, Instr.BrIf(0), [], [], [], 0, Label(cont = 4, arity = 1, base = 1), 2, 1).code => Vector.fromList([Instr.BrIf(0)])

verify plainJump
    plainJump(3, 1) => Instr.JumpIf(3)

fn resolveBranch(rs: Rs, pc: Int, i: Instr, labels: List<Label>, out: List<Instr>, ts: List<Label>, nt: Int, d: Option<Int>) -> Resolved
    ? "A branch gets the next target index in place of its depth; anything else stays."
    match d
        Option.Some(k) -> resolveFrom(rs, pc + 1, labels, List.prepend(withTarget(i, nt), out), List.prepend(targetOf(labels, k, rs.results), ts), nt + 1)
        Option.None -> resolveFrom(rs, pc + 1, labels, List.prepend(i, out), ts, nt)

fn falseArm(nps: Vector<Int>, els: Int, end: Int) -> Int
    ? "Where an if goes when its condition fails: just past its else (which is now a jump), or past its end when it has none."
    match els == end
        true -> intAt(nps, end)
        false -> intAt(nps, els) + 1

fn innerCont(labels: List<Label>) -> Int
    ? "Where the innermost block continues."
    match labels
        [l, .._] -> l.cont
        [] -> -1

fn targetOf(labels: List<Label>, d: Int, results: Int) -> Label
    ? "The target of a branch d levels out; past the open blocks it is the function's own, which returns."
    match List.drop(labels, d)
        [l, .._] -> l
        [] -> Label(cont = -1, arity = results, base = 0)

fn addTargets(ds: List<Int>, labels: List<Label>, results: Int, ts: List<Label>) -> List<Label>
    ? "ts with the targets of ds added, in order."
    match ds
        [] -> ts
        [d, ..rest] -> addTargets(rest, labels, results, List.prepend(targetOf(labels, d, results), ts))

fn countFrom(k: Int, n: Int, acc: List<Int>) -> List<Int>
    ? "k, k + 1, ... up to n numbers."
    match n <= 0
        true -> List.reverse(acc)
        false -> countFrom(k + 1, n - 1, List.prepend(k, acc))

fn depthOf(i: Instr) -> Option<Int>
    ? "The label depth of a single-target branch."
    match i
        Instr.Br(d) -> Option.Some(d)
        Instr.BrIf(d) -> Option.Some(d)
        Instr.BrOnNull(d) -> Option.Some(d)
        Instr.BrOnNonNull(d) -> Option.Some(d)
        Instr.BrOnCast(d, _, _, _) -> Option.Some(d)
        Instr.BrOnCastFail(d, _, _, _) -> Option.Some(d)
        _ -> Option.None

fn withTarget(i: Instr, k: Int) -> Instr
    ? "A branch pointed at target k."
    match i
        Instr.Br(_) -> Instr.Br(k)
        Instr.BrIf(_) -> Instr.BrIf(k)
        Instr.BrOnNull(_) -> Instr.BrOnNull(k)
        Instr.BrOnNonNull(_) -> Instr.BrOnNonNull(k)
        Instr.BrOnCast(_, fl, a, b) -> Instr.BrOnCast(k, fl, a, b)
        Instr.BrOnCastFail(_, fl, a, b) -> Instr.BrOnCastFail(k, fl, a, b)
        _ -> i

verify resolve
    resolve(Vector.fromList([Instr.Block(0, 0, 2, Sig(params = [], results = [], ty = -1)), Instr.Br(0), Instr.End, Instr.End]), Vector.fromList([0, 0, 0, 0]), 0) => Resolved(code = Vector.fromList([Instr.Jump(1), Instr.End]), targets = Vector.fromList([]))
    resolve(Vector.fromList([Instr.I32Const(1), Instr.If(1, 0, 3, 5, Sig(params = [], results = [ValType.I32], ty = -1)), Instr.I32Const(2), Instr.Else, Instr.I32Const(3), Instr.End, Instr.End]), Vector.fromList([0, 1, 0, 1, 0, 1, 1]), 1).code => Vector.fromList([Instr.I32Const(1), Instr.IfNot(4), Instr.I32Const(2), Instr.Jump(5), Instr.I32Const(3), Instr.End])
    resolve(Vector.fromList([Instr.Loop(0, Sig(params = [], results = [], ty = -1)), Instr.BrIf(1), Instr.Br(0), Instr.End, Instr.End]), Vector.fromList([0, 0, 0, 0, 0]), 0) => Resolved(code = Vector.fromList([Instr.BrIf(0), Instr.Jump(0), Instr.End]), targets = Vector.fromList([Label(cont = -1, arity = 0, base = 0)]))

verify newPcs
    newPcs(Vector.fromList([Instr.Block(0, 0, 1, Sig(params = [], results = [], ty = -1)), Instr.End, Instr.End]), 2, 0, 0, []) => [0, 0, 0, 1]

verify keptOf
    keptOf(Instr.End, true) => 1
    keptOf(Instr.End, false) => 0

verify intAt
    intAt(Vector.fromList([4]), 1) => 0

verify resolveFrom
    resolveFrom(Rs(code = Vector.fromList([]), hs = Vector.fromList([]), nps = Vector.fromList([0]), results = 0, last = -1), 0, [], [], [], 0) => Resolved(code = Vector.fromList([]), targets = Vector.fromList([]))

verify resolveOne
    resolveOne(Rs(code = Vector.fromList([Instr.Nop]), hs = Vector.fromList([0]), nps = Vector.fromList([0, 1]), results = 0, last = 0), 0, Instr.Nop, 0, [], [], [], 0).code => Vector.fromList([Instr.Nop])

verify resolveEnd
    resolveEnd(Rs(code = Vector.fromList([Instr.End]), hs = Vector.fromList([0]), nps = Vector.fromList([0, 1]), results = 0, last = 0), 0, [], [], [], 0).code => Vector.fromList([Instr.End])

verify resolveBranch
    resolveBranch(Rs(code = Vector.fromList([Instr.Br(0)]), hs = Vector.fromList([0]), nps = Vector.fromList([0, 1]), results = 2, last = 0), 0, Instr.Br(0), [], [], [], 0, Option.Some(0)).targets => Vector.fromList([Label(cont = -1, arity = 2, base = 0)])

verify falseArm
    falseArm(Vector.fromList([0, 1, 2, 3]), 2, 2) => 2
    falseArm(Vector.fromList([0, 1, 2, 3]), 1, 2) => 2

verify innerCont
    innerCont([]) => -1

verify targetOf
    targetOf([Label(cont = 4, arity = 1, base = 0)], 0, 0) => Label(cont = 4, arity = 1, base = 0)

verify addTargets
    addTargets([0, 1], [Label(cont = 4, arity = 1, base = 0)], 0, []) => [Label(cont = -1, arity = 0, base = 0), Label(cont = 4, arity = 1, base = 0)]

verify countFrom
    countFrom(3, 2, []) => [3, 4]

verify depthOf
    depthOf(Instr.Nop) => Option.None

verify withTarget
    withTarget(Instr.BrIf(5), 2) => Instr.BrIf(2)

verify buildFns
    buildFns(Ast.emptyModule(), [], [], []) => []

verify firstShape
    firstShape([]) => Shape(maxH = 0, heights = Vector.fromList([]))

fn emptyStore(m: Module) -> Store
    ? "The store before globals, tables and segments are set up."
    Store(globals = Vector.fromList([]), heap = Kompost.empty(), mem = {}, pages = m.memMin, maxPages = Int.min(m.memMax, pageCap(m, 0)), memAt = memAtOf(m), others = othersOf(m, m.moreMems, 1, {}), tables = Vector.fromList(tablesOf(m.tables, m.tableMins, [])), elems = Vector.fromList([]), datas = Vector.fromList(dataBytes(List.fromVector(m.datas), [])), gcAt = 65536, pinned = [], steps = 0, mods = {})

fn othersOf(m: Module, ms: List<MemType>, k: Int, acc: Map<Int, MemState>) -> Map<Int, MemState>
    ? "Memories 1 and up, each empty at its minimum size."
    match ms
        [] -> acc
        [t, ..rest] -> othersOf(m, rest, k + 1, Map.set(acc, k, MemState(mem = {}, pages = t.min, maxPages = Int.min(t.max, pageCap(m, k)))))

fn pageCap(m: Module, k: Int) -> Int
    ? "The most pages memory k may have: 65536, or 2^48 when it is 64-bit."
    match Ast.memIs64(m, k)
        true -> 281474976710656
        false -> 65536

verify othersOf
    Map.len(othersOf(Ast.emptyModule(), [MemType(min = 1, max = 2)], 1, {})) => 1

verify pageCap
    pageCap(Ast.emptyModule(), 0) => 65536

fn tablesOf(ts: List<ValType>, mins: List<Int>, acc: List<Vector<Val>>) -> List<Vector<Val>>
    ? "Each table at its minimum size, full of nulls."
    match mins
        [] -> List.reverse(acc)
        [n, ..rest] -> tablesOf(ts, rest, List.prepend(Vector.fromList(repeatVal(Val.Null, n, [])), acc))

verify tablesOf
    tablesOf([], [2], []) => [Vector.fromList([Val.Null, Val.Null])]

fn dataBytes(ds: List<Data>, acc: List<Vector<Int>>) -> List<Vector<Int>>
    ? "The octets of every data segment."
    match ds
        [] -> List.reverse(acc)
        [d, ..rest] -> dataBytes(rest, List.prepend(d.bytes, acc))

verify dataBytes
    dataBytes([], []) => []

record VS
    v: Val
    s: Store

fn evalConst(x: Inst, code: Vector<Instr>, s: Store) -> Result<VS, String>
    ? "The value of a constant expression, which may allocate."
    r = run(x, frame(code, Vector.fromList([]), Vector.fromList([]), Vector.len(code) + 1, 1), [], s)
    match r
        Outcome.Done([v], s2) -> Result.Ok(VS(v = v, s = s2))
        Outcome.Trap(e, _) -> Result.Err(e)
        Outcome.Thrown(_, _, _) -> Result.Err("uncaught exception")
        _ -> Result.Err("constant expression did not produce one value")

fn instantiate(m: Module, hostGlobals: Map<String, Val>, shapes: Vector<Shape>) -> Result<Ready, String>
    ? "The module ready to run: imported globals taken from hostGlobals (keyed module.name), the rest evaluated, segments placed, the start function not yet run. shapes holds what validation learnt of each body: its highest operand stack and the height before each instruction."
    r = prepare(m, hostGlobals, shapes, 0)?
    s = settle(r.x, r.s)?
    Result.Ok(Ready(x = r.x, s = s))

fn prepare(m: Module, hostGlobals: Map<String, Val>, shapes: Vector<Shape>, base: Int) -> Result<Ready, String>
    ? "The first half of instantiating a lone module into a fresh store."
    prepareIn(blankStore(), m, hostGlobals, shapes, Int.div(base, 4294967296), noLinks())

record Links
    globals: Map<Int, Int>
    tables: Map<Int, Int>
    mems: Map<Int, Int>
    tags: Vector<Int>

fn noLinks() -> Links
    ? "Nothing imported from another instance."
    Links(globals = {}, tables = {}, mems = {}, tags = Vector.fromList([]))

fn blankStore() -> Store
    ? "A store with nothing in it yet."
    Store(globals = Vector.fromList([]), heap = Kompost.empty(), mem = {}, pages = 0, maxPages = 0, memAt = -1, others = {}, tables = Vector.fromList([]), elems = Vector.fromList([]), datas = Vector.fromList([]), gcAt = 65536, pinned = [], steps = 0, mods = {})

fn prepareIn(s0: Store, m: Module, hostGlobals: Map<String, Val>, shapes: Vector<Shape>, id: Int, links: Links) -> Result<Ready, String>
    ? "The first half of instantiating m as instance id into a store other instances may share: its own globals, tables and segments get the next addresses, its own memories the addresses id * 65536 + k, what it imports from another instance (links) that instance's addresses; functions built, globals and tables initialized, segments evaluated but not placed. Memory 0 of the instance ends up on top of the store."
    ga = addrs(Vector.len(m.globals), links.globals, Vector.len(s0.globals), 0, [])
    ta = addrs(List.len(m.tables), links.tables, Vector.len(s0.tables), 0, [])
    ma = memAddrs(Ast.memCount(m), links.mems, id * 65536, 0, [])
    ea = countFrom(Vector.len(s0.elems), Vector.len(m.elems), [])
    da = countFrom(Vector.len(s0.datas), Vector.len(m.datas), [])
    isFlat = Bool.and(Bool.and(isIdentity(ga, 0), isIdentity(ta, 0)), Bool.and(isIdentity(ma, 0), Bool.and(isIdentity(ea, 0), isIdentity(da, 0))))
    x = Inst(m = m, fns = Vector.fromList(buildFns(m, List.fromVector(m.funcs), List.fromVector(shapes), [])), base = id * 4294967296, tags = links.tags, ga = Vector.fromList(ga), ta = Vector.fromList(ta), ma = Vector.fromList(ma), ea = Vector.fromList(ea), da = Vector.fromList(da), flat = isFlat)
    s1 = swapTo(Store.update(extended(s0, m, ma, links), mods = Map.set(s0.mods, id, m)), maddr(x, 0))
    s2 = initGlobals(x, List.fromVector(m.globals), 0, s1, hostGlobals, links.globals)?
    s3 = initTables(x, m.tableInits, 0, s2)?
    s4 = initElems(x, List.fromVector(m.elems), s3, [])?
    Result.Ok(Ready(x = x, s = s4))

fn addrs(n: Int, linked: Map<Int, Int>, next: Int, j: Int, acc: List<Int>) -> List<Int>
    ? "The address of each of n objects: a linked one's from linked, the others the next free addresses in order."
    match j >= n
        true -> List.reverse(acc)
        false -> match Map.get(linked, j)
            Option.Some(a) -> addrs(n, linked, next, j + 1, List.prepend(a, acc))
            Option.None -> addrs(n, linked, next + 1, j + 1, List.prepend(next, acc))

fn memAddrs(n: Int, linked: Map<Int, Int>, base: Int, k: Int, acc: List<Int>) -> List<Int>
    ? "The address of each memory: a linked one's, or base + k for one of its own."
    match k >= n
        true -> List.reverse(acc)
        false -> memAddrs(n, linked, base, k + 1, List.prepend(Option.withDefault(Map.get(linked, k), base + k), acc))

fn isIdentity(xs: List<Int>, k: Int) -> Bool
    ? "Whether xs is 0, 1, 2, ..."
    match xs
        [] -> true
        [x, ..rest] -> Bool.and(x == k, isIdentity(rest, k + 1))

fn extended(s: Store, m: Module, ma: List<Int>, links: Links) -> Store
    ? "The store with m's own tables (at their minimum size, full of nulls), data segments and memories added, and m's memory 0 on top."
    t = Store.update(s, tables = Vector.fromList(List.concat(List.fromVector(s.tables), ownTables(m.tableMins, links.tables, 0, []))), datas = Vector.fromList(List.concat(List.fromVector(s.datas), dataBytes(List.fromVector(m.datas), []))))
    withOwnMems(t, m, ma, links.mems, 0)

fn ownTables(mins: List<Int>, linked: Map<Int, Int>, j: Int, acc: List<Vector<Val>>) -> List<Vector<Val>>
    ? "A table of nulls at its minimum size for each table that is not linked."
    match mins
        [] -> List.reverse(acc)
        [n, ..rest] -> match Map.has(linked, j)
            true -> ownTables(rest, linked, j + 1, acc)
            false -> ownTables(rest, linked, j + 1, List.prepend(Vector.fromList(repeatVal(Val.Null, n, [])), acc))

fn withOwnMems(s: Store, m: Module, ma: List<Int>, linked: Map<Int, Int>, k: Int) -> Store
    ? "Each memory that is not linked added under its address, then memory 0 put on top."
    match ma
        [] -> topMem(s, m)
        [a, ..rest] -> match Map.has(linked, k)
            true -> withOwnMems(s, m, rest, linked, k + 1)
            false -> withOwnMems(Store.update(s, others = Map.set(s.others, a, freshMem(m, k))), m, rest, linked, k + 1)

fn topMem(s: Store, m: Module) -> Store
    ? "Nothing to do here: the caller puts memory 0 on top once the addresses are known (see prepareIn)."
    s

fn freshMem(m: Module, k: Int) -> MemState
    ? "Memory k of m, empty at its minimum size."
    match k == 0
        true -> MemState(mem = {}, pages = m.memMin, maxPages = Int.min(m.memMax, pageCap(m, 0)))
        false -> match List.drop(m.moreMems, k - 1)
            [t, .._] -> MemState(mem = {}, pages = t.min, maxPages = Int.min(t.max, pageCap(m, k)))
            [] -> MemState(mem = {}, pages = 0, maxPages = 0)

verify prepareIn
    Result.withDefault(prepareIn(blankStore(), Module.update(Ast.emptyModule(), memMin = 2, hasMemory = true), {}, Vector.fromList([]), 0, noLinks()), Ready(x = Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), s = blankStore())).s.pages => 2

verify addrs
    addrs(3, {1 => 9}, 4, 0, []) => [4, 9, 5]

verify memAddrs
    memAddrs(2, {0 => 7}, 65536, 0, []) => [7, 65537]

verify isIdentity
    isIdentity([0, 1, 2], 0) => true
    isIdentity([0, 2], 0) => false

verify extended
    Vector.len(extended(blankStore(), Module.update(Ast.emptyModule(), tables = [ValType.Ref(true, -16)], tableMins = [2]), [], noLinks()).tables) => 1

verify ownTables
    ownTables([1, 2], {0 => 5}, 0, []) => [Vector.fromList([Val.Null, Val.Null])]

verify withOwnMems
    Map.len(withOwnMems(blankStore(), Module.update(Ast.emptyModule(), hasMemory = true), [65536], {}, 0).others) => 1

verify topMem
    topMem(blankStore(), Ast.emptyModule()) => blankStore()

verify freshMem
    freshMem(Module.update(Ast.emptyModule(), memMin = 3, hasMemory = true), 0).pages => 3

fn settle(x: Inst, s: Store) -> Result<Store, String>
    ? "The second half: active element and data segments copied into their tables and memories."
    r = settlePart(x, s)
    match r.err == ""
        true -> Result.Ok(r.s)
        false -> Result.Err(r.err)

record Settled
    s: Store
    err: String

fn settlePart(x: Inst, s: Store) -> Settled
    ? "settle, keeping what was written before a segment failed: segments are placed in order, so a linker can hand the earlier writes to the memories and tables the module imports. err is empty when every segment fit."
    r = elemsPart(x, List.fromVector(x.m.elems), 0, s)
    match r.err == ""
        false -> r
        true -> datasPart(x, List.fromVector(x.m.datas), 0, r.s)

fn elemsPart(x: Inst, es: List<Elem>, k: Int, s: Store) -> Settled
    ? "placeElems, one segment at a time."
    match es
        [] -> Settled(s = s, err = "")
        [e, ..rest] -> match placeElem(x, e, k, s)
            Result.Ok(s2) -> elemsPart(x, rest, k + 1, s2)
            Result.Err(msg) -> Settled(s = s, err = msg)

fn datasPart(x: Inst, ds: List<Data>, k: Int, s: Store) -> Settled
    ? "placeDatas, one segment at a time."
    match ds
        [] -> Settled(s = s, err = "")
        [d, ..rest] -> match placeData(x, d, k, s)
            Result.Ok(s2) -> datasPart(x, rest, k + 1, s2)
            Result.Err(msg) -> Settled(s = s, err = msg)

verify settlePart
    settlePart(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule())).err => ""

verify elemsPart
    elemsPart(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), [], 0, emptyStore(Ast.emptyModule())).err => ""

verify datasPart
    datasPart(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), [], 0, emptyStore(Ast.emptyModule())).err => ""

fn memState(s: Store, a: Int) -> MemState
    ? "The memory at address a as it stands."
    match a == s.memAt
        true -> MemState(mem = s.mem, pages = s.pages, maxPages = s.maxPages)
        false -> Option.withDefault(Map.get(s.others, a), MemState(mem = {}, pages = 0, maxPages = 0))

verify prepare
    Result.withDefault(prepare(Ast.emptyModule(), {}, Vector.fromList([]), 0), Ready(x = Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), s = emptyStore(Ast.emptyModule()))).s.pages => 0

verify settle
    settle(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), emptyStore(Ast.emptyModule())) => Result.Ok(emptyStore(Ast.emptyModule()))

verify memState
    memState(emptyStore(Module.update(Ast.emptyModule(), memMin = 2, hasMemory = true)), 0).pages => 2


fn initTables(x: Inst, inits: List<Vector<Instr>>, t: Int, s: Store) -> Result<Store, String>
    ? "Fills each table that has an initializer expression with its value."
    match inits
        [] -> Result.Ok(s)
        [e, ..rest] -> initTables(x, rest, t + 1, initTable(x, e, t, s)?)

fn initTable(x: Inst, e: Vector<Instr>, t: Int, s: Store) -> Result<Store, String>
    ? "Table t filled with the value of e, when it has one."
    match Vector.len(e) == 0
        true -> Result.Ok(s)
        false -> filledTable(x, t, evalConst(x, e, s)?)

fn filledTable(x: Inst, t: Int, r: VS) -> Result<Store, String>
    ? "Every element of table t set to the value."
    Result.Ok(setTable(r.s, taddr(x, t), Vector.fromList(repeatVal(r.v, Vector.len(table(r.s, taddr(x, t))), []))))

verify initTables
    initTables(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), [], 0, emptyStore(Ast.emptyModule())) => Result.Ok(emptyStore(Ast.emptyModule()))

verify initTable
    initTable(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Vector.fromList([]), 0, emptyStore(Ast.emptyModule())) => Result.Ok(emptyStore(Ast.emptyModule()))

fn initGlobals(x: Inst, gs: List<Global>, j: Int, s: Store, hg: Map<String, Val>, linked: Map<Int, Int>) -> Result<Store, String>
    ? "Evaluates each global's initializer in order; each may read the globals before it. One imported from the host takes the host's value; one linked to another instance's global is that global, already in the store."
    match gs
        [] -> Result.Ok(s)
        [g, ..rest] -> match Map.has(linked, j)
            true -> initGlobals(x, rest, j + 1, s, hg, linked)
            false -> initGlobalsNext(x, globalValue(x, g, s, hg)?, rest, j, hg, linked)

fn globalValue(x: Inst, g: Global, s: Store, hg: Map<String, Val>) -> Result<VS, String>
    ? "A global's initial value: from the host when imported, else its initializer's."
    match g.from == ""
        true -> evalConst(x, g.init, s)
        false -> Result.Ok(VS(v = Result.fromOption(Map.get(hg, g.from), "unknown import {g.from}")?, s = s))

fn initGlobalsNext(x: Inst, r: VS, rest: List<Global>, j: Int, hg: Map<String, Val>, linked: Map<Int, Int>) -> Result<Store, String>
    ? "Appends one global's value and evaluates the rest."
    initGlobals(x, rest, j + 1, Store.update(r.s, globals = Vector.fromList(List.concat(List.fromVector(r.s.globals), [r.v]))), hg, linked)

fn initElems(x: Inst, es: List<Elem>, s: Store, acc: List<Vector<Val>>) -> Result<Store, String>
    ? "Evaluates the items of every element segment."
    match es
        [] -> Result.Ok(Store.update(s, elems = Vector.fromList(List.concat(List.fromVector(s.elems), List.reverse(acc)))))
        [e, ..rest] -> initElemsNext(x, evalItems(x, e.items, s, [])?, rest, acc)

record VLS
    vs: List<Val>
    s: Store

fn initElemsNext(x: Inst, r: VLS, rest: List<Elem>, acc: List<Vector<Val>>) -> Result<Store, String>
    ? "Keeps one segment's values and evaluates the rest."
    initElems(x, rest, r.s, List.prepend(Vector.fromList(r.vs), acc))

fn evalItems(x: Inst, items: List<Vector<Instr>>, s: Store, acc: List<Val>) -> Result<VLS, String>
    ? "Evaluates constant expressions in order."
    match items
        [] -> Result.Ok(VLS(vs = List.reverse(acc), s = s))
        [c, ..rest] -> evalItemsNext(x, evalConst(x, c, s)?, rest, acc)

fn evalItemsNext(x: Inst, r: VS, rest: List<Vector<Instr>>, acc: List<Val>) -> Result<VLS, String>
    ? "Keeps one value and evaluates the rest."
    evalItems(x, rest, r.s, List.prepend(r.v, acc))

fn placeElems(x: Inst, es: List<Elem>, k: Int, s: Store) -> Result<Store, String>
    ? "Copies active segments into their tables, then drops active and declarative segments."
    match es
        [] -> Result.Ok(s)
        [e, ..rest] -> placeElems(x, rest, k + 1, placeElem(x, e, k, s)?)

fn placeElem(x: Inst, e: Elem, k: Int, s: Store) -> Result<Store, String>
    ? "Places one segment by its mode."
    match e.mode
        0 -> placeActiveElem(x, e, k, evalConst(x, e.offset, s)?)
        1 -> Result.Ok(s)
        _ -> Result.Ok(Store.update(s, elems = dropSeg(s.elems, eaddr(x, k))))

fn placeActiveElem(x: Inst, e: Elem, k: Int, r: VS) -> Result<Store, String>
    ? "Writes an active segment at its offset."
    seg = elemSeg(r.s, eaddr(x, k))
    tb = table(r.s, taddr(x, e.table))
    off = idx(r.v)
    match off + Vector.len(seg) > Vector.len(tb)
        true -> Result.Err("out of bounds table access")
        false -> Result.Ok(Store.update(setTable(r.s, taddr(x, e.table), writeVals(tb, off, List.fromVector(seg))), elems = dropSeg(r.s.elems, eaddr(x, k))))

fn placeDatas(x: Inst, ds: List<Data>, k: Int, s: Store) -> Result<Store, String>
    ? "Copies active data segments into memory and drops them."
    match ds
        [] -> Result.Ok(s)
        [d, ..rest] -> placeDatas(x, rest, k + 1, placeData(x, d, k, s)?)

fn placeData(x: Inst, d: Data, k: Int, s: Store) -> Result<Store, String>
    ? "Places one data segment when it is active."
    match d.active
        false -> Result.Ok(s)
        true -> placeActiveData(x, d, k, evalConst(x, d.offset, s)?)

fn placeActiveData(x: Inst, d: Data, k: Int, r: VS) -> Result<Store, String>
    ? "Writes an active data segment at its offset in its memory."
    placeIn(x, d, k, idx(r.v), withMem(x, r.s, d.mem))

fn placeIn(x: Inst, d: Data, k: Int, off: Int, s: Store) -> Result<Store, String>
    ? "Writes the segment with its memory on top, then puts memory 0 back on top."
    match off + Vector.len(d.bytes) > memBytes(s)
        true -> Result.Err("out of bounds memory access")
        false -> Result.Ok(memBack(x, Store.update(s, mem = Mem.writeList(s.mem, off, List.fromVector(d.bytes)), datas = Option.withDefault(Vector.set(s.datas, daddr(x, k), Vector.fromList([])), s.datas)), d.mem))

fn exportFunc(m: Module, name: String) -> Option<Int>
    ? "The index of the function exported under name."
    findExport(m.exports, name)

fn findExport(es: List<Export>, name: String) -> Option<Int>
    ? "Searches the exports for a function named name."
    match es
        [] -> Option.None
        [e, ..rest] -> findExportAt(e, rest, name)

fn findExportAt(e: Export, rest: List<Export>, name: String) -> Option<Int>
    ? "The export e when it is the function named name, else the search goes on."
    match Bool.and(e.name == name, e.kind == 0)
        true -> Option.Some(e.index)
        false -> findExport(rest, name)

verify exportFunc
    exportFunc(Module.update(Ast.emptyModule(), exports = [Export(name = "f", kind = 0, index = 3)]), "f") => Option.Some(3)
    exportFunc(Ast.emptyModule(), "f") => Option.None

verify findExport
    findExport([], "f") => Option.None

verify findExportAt
    findExportAt(Export(name = "g", kind = 0, index = 1), [], "f") => Option.None

fn invoke(x: Inst, s: Store, fi: Int, args: List<Val>) -> Outcome
    ? "Calls function fi with arguments in order, as the host would."
    nres = List.len(Ast.funcResults(x.m, fnType(x, fi)))
    caller = pushAll(bare(Vector.fromList([]), List.len(args) + nres + 1, nres), args)
    proceed(x, call(x, fi, caller, [], s, false))

fn proceed(x: Inst, nx: Next) -> Outcome
    ? "Runs on from where a step left the machine."
    match nx
        Next.Go(f, calls, s) -> run(x, f, calls, s)
        Next.Out(o) -> o

fn resume(x: Inst, mach: Machine, results: List<Val>, tail: Bool) -> Outcome
    ? "Continues after the host answered a call with results in order; after a tail call to the host, the calling function returns them."
    f = pushAll(mach.frame, results)
    match tail
        true -> proceed(x, doReturn(x, f, mach.calls, mach.store))
        false -> run(x, f, mach.calls, mach.store)

fn writeMem(mem: Map<Int, Vector<Int>>, ea: Int, bs: List<Int>) -> Map<Int, Vector<Int>>
    ? "Linear memory with octets written from ea, for the host."
    Mem.writeList(mem, ea, bs)

verify writeMem
    Map.len(writeMem({}, 0, [1])) => 1

fn machineRoots(mach: Machine) -> List<Val>
    ? "The values a suspended machine holds outside the heap, for the host to pin while it calls back into the guest."
    List.concat(List.fromVector(mach.frame.locals), List.concat(stackVals(mach.frame, 0), frameRoots(mach.calls, [])))
