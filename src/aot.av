verify elseArm
    elseArm(Cx(m = Ast.emptyModule(), pre = "", fi = 0, code = Vector.fromList([]), ltys = [], res = [], natives = {}, allocs = {}, tails = {}, live = Vector.fromList([])), 1, 1, St(ls = [], stk = [], s = "s", top = true, ind = 4), [], Gl(n = 0, fns = [], alias = [])).t => "R.V0(s)"

verify targeted
    targeted([Instr.Block(0, 0, 2, Sig(params = [], results = [], ty = -1)), Instr.Br(0), Instr.End], 1, 2, 0) => true
    targeted([Instr.Block(0, 0, 2, Sig(params = [], results = [], ty = -1)), Instr.Nop, Instr.End], 1, 2, 0) => false

verify branchesTo
    branchesTo(Instr.Br(1), 1) => true

verify nesting
    nesting(Instr.End) => -1
