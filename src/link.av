module Link
    intent =
        "Several instances linked in one store, as the spec testsuite's scripts"
        "make them, the way WebAssembly defines it: every global, table,"
        "memory, segment and heap object lives in the one store, and an"
        "instance maps its own indices to store addresses (see Exec.prepareIn),"
        "so an import is the exporter's very object. A call into another"
        "instance (an import, or a reference to its function) stops the machine"
        "like a call to the host; the world runs the callee on the same store,"
        "with the callee's memory 0 on top and the caller's frames pinned for"
        "the collector, then resumes the caller. Exceptions cross instances"
        "with tag identities; imports are checked against what provides them."
    exposes [World, Called, Exn, empty, add, register, call, moduleOf]
    depends [Ast, Value, Exec, Kompost, Valid, Types]
    effects []

record World
    s: Store
    insts: Map<Int, Inst>
    named: Map<String, Int>

record Called
    w: World
    r: Result<List<Val>, String>
    exn: Option<Exn>

record Exn
    tag: Int
    vals: List<Val>

fn empty() -> World
    ? "No instances yet, an empty store."
    World(s = Exec.blankStore(), insts = {}, named = {})

verify empty
    Map.len(empty().insts) => 0

fn register(w: World, name: String, id: Int) -> World
    ? "Instance id becomes importable under the module name name."
    World.update(w, named = Map.set(w.named, name, id))

verify register
    Map.get(register(empty(), "M", 3).named, "M") => Option.Some(3)

fn moduleOf(w: World, id: Int) -> Option<Module>
    ? "The module of instance id."
    match Map.get(w.insts, id)
        Option.Some(x) -> Option.Some(x.m)
        Option.None -> Option.None

verify moduleOf
    moduleOf(empty(), 0) => Option.None
    moduleOf(add(empty(), 0, Ast.emptyModule(), Vector.fromList([]), {}).w, 0) => Option.Some(Ast.emptyModule())

// ---- instantiation ----

fn add(w: World, id: Int, m: Module, shapes: Vector<Shape>, hostGlobals: Map<String, Val>) -> Called
    ? "Instantiates m as instance id: imports checked, its own objects added to the store, what it imports linked to the exporters' objects, segments placed, then its start function run. When a segment does not fit, the instantiation fails but what earlier segments wrote stays in the store, and the instance stays (unnamed) so functions it put into an imported table can still be called."
    match importsOk(w, m, m.imports)
        Result.Err(e) -> Called(w = w, r = Result.Err(e), exn = Option.None)
        Result.Ok(_) -> prepared(w, id, m.start, Exec.prepareIn(w.s, m, hostGlobals, shapes, id, linksOf(w, m, id)))

fn prepared(w: World, id: Int, start: Int, r: Result<Ready, String>) -> Called
    ? "Places the segments of a prepared instance."
    match r
        Result.Err(e) -> Called(w = w, r = Result.Err(e), exn = Option.None)
        Result.Ok(ready) -> settled(World.update(w, insts = Map.set(w.insts, id, ready.x)), id, start, Exec.settlePart(ready.x, ready.s))

fn settled(w: World, id: Int, start: Int, r: Settled) -> Called
    ? "Keeps the store the segments left; runs the start function when they all fit."
    match r.err == ""
        false -> Called(w = World.update(w, s = r.s), r = Result.Err(r.err), exn = Option.None)
        true -> started(World.update(w, s = r.s), id, start)

fn started(w: World, id: Int, start: Int) -> Called
    ? "Runs the start function when there is one."
    match start < 0
        true -> Called(w = w, r = Result.Ok([]), exn = Option.None)
        false -> call(w, id, start, [])

verify add
    add(empty(), 0, Ast.emptyModule(), Vector.fromList([]), {}).r => Result.Ok([])

verify prepared
    prepared(empty(), 0, -1, Result.Err("x")).r => Result.Err("x")

verify settled
    settled(empty(), 0, -1, Settled(s = Exec.blankStore(), err = "x")).r => Result.Err("x")

verify started
    started(empty(), 0, -1).r => Result.Ok([])

fn linksOf(w: World, m: Module, id: Int) -> Links
    ? "The store addresses of the globals, tables and memories m imports from registered instances, and the identities of its tags."
    Links(globals = linkedOf(w, m.imports, 3, {}), tables = linkedOf(w, m.imports, 1, {}), mems = linkedOf(w, m.imports, 2, {}), tags = Vector.fromList(tagIds(w, m, id * 4294967296, 0, [])))

fn linkedOf(w: World, is: List<Import>, kind: Int, acc: Map<Int, Int>) -> Map<Int, Int>
    ? "For each import of this kind from a registered instance, its local index and the exporter's address of the object."
    match is
        [] -> acc
        [i, ..rest] -> linkedOf(w, rest, kind, linkOne(w, i, kind, acc))

fn linkOne(w: World, i: Import, kind: Int, acc: Map<Int, Int>) -> Map<Int, Int>
    ? "acc with one import's address, when it is of this kind and comes from a registered instance."
    match Bool.and(i.kind == kind, Map.has(w.named, i.mod))
        false -> acc
        true -> match Map.get(w.insts, Option.withDefault(Map.get(w.named, i.mod), 0))
            Option.None -> acc
            Option.Some(ex) -> match exportOf(ex.m, i.name, kind)
                Option.None -> acc
                Option.Some(k) -> Map.set(acc, i.index, addressOf(ex, kind, k))

fn addressOf(x: Inst, kind: Int, k: Int) -> Int
    ? "The store address of object k of this kind in instance x."
    match kind
        1 -> Exec.taddr(x, k)
        2 -> Exec.maddr(x, k)
        _ -> Exec.gaddr(x, k)

verify linksOf
    Map.len(linksOf(empty(), Ast.emptyModule(), 0).globals) => 0

verify linkedOf
    linkedOf(empty(), [], 3, {}) => {}

verify linkOne
    linkOne(empty(), Import(mod = "M", name = "g", kind = 3, index = 0, lo = 0, hi = 0, hasMax = false), 3, {}) => {}

verify addressOf
    addressOf(Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 2, 1) => 1

// ---- running ----

fn call(w: World, id: Int, fi: Int, args: List<Val>) -> Called
    ? "Calls function fi of instance id on the world's store, with its memory 0 on top."
    match Map.get(w.insts, id)
        Option.None -> Called(w = w, r = Result.Err("no instance {id}"), exn = Option.None)
        Option.Some(x) -> runOut(w, x, Exec.invoke(x, Exec.swapTo(w.s, Exec.maddr(x, 0)), fi, args))

fn runOut(w: World, x: Inst, out: Outcome) -> Called
    ? "Follows the machine: whatever happens, the store it ends with is the world's."
    match out
        Outcome.Done(vs, s) -> Called(w = World.update(w, s = s), r = Result.Ok(vs), exn = Option.None)
        Outcome.Trap(e, s) -> Called(w = World.update(w, s = s), r = Result.Err("trap: {e}"), exn = Option.None)
        Outcome.Thrown(t, vs, s) -> Called(w = World.update(w, s = s), r = Result.Err("uncaught exception"), exn = Option.Some(Exn(tag = t, vals = vs)))
        Outcome.Host(fi, args, tail, mach) -> hostOut(w, x, fi, args, tail, mach)

fn hostOut(w: World, x: Inst, fi: Int, args: List<Val>, tail: Bool, mach: Machine) -> Called
    ? "An import or a foreign reference called: a reference to another instance's function (fi below 0, see Exec.foreignCall) or an import from a registered instance runs there; spectest's functions do nothing."
    match fi < 0
        true -> across(w, x, Int.div(-1 - fi, 4294967296), Int.mod(-1 - fi, 4294967296), args, tail, mach)
        false -> match Vector.get(x.fns, fi)
            Option.None -> Called(w = w, r = Result.Err("call to an undefined import"), exn = Option.None)
            Option.Some(g) -> imported(w, x, g, args, tail, mach)

fn imported(w: World, x: Inst, g: Fn, args: List<Val>, tail: Bool, mach: Machine) -> Called
    ? "An imported function: spectest's do nothing, a registered instance's export runs there."
    match g.mod == "spectest"
        true -> runOut(w, x, Exec.resume(x, mach, [], tail))
        false -> match Map.get(w.named, g.mod)
            Option.None -> Called(w = w, r = Result.Err("unknown import {g.mod}.{g.name}"), exn = Option.None)
            Option.Some(e) -> importedFrom(w, x, e, g, args, tail, mach)

fn importedFrom(w: World, x: Inst, e: Int, g: Fn, args: List<Val>, tail: Bool, mach: Machine) -> Called
    ? "Finds the export of instance e the import names and runs it."
    match moduleOf(w, e)
        Option.None -> Called(w = w, r = Result.Err("unknown import {g.mod}.{g.name}"), exn = Option.None)
        Option.Some(em) -> match exportOf(em, g.name, 0)
            Option.None -> Called(w = w, r = Result.Err("unknown import {g.mod}.{g.name}"), exn = Option.None)
            Option.Some(efi) -> across(w, x, e, efi, args, tail, mach)

fn across(w: World, x: Inst, e: Int, efi: Int, args: List<Val>, tail: Bool, mach: Machine) -> Called
    ? "Runs function efi of instance e on the caller's store, the caller's frames and the arguments pinned so the collector keeps what they hold, then resumes the caller."
    pinnedBefore = mach.store.pinned
    s = Store.update(mach.store, pinned = List.concat(args, List.concat(Exec.machineRoots(mach), mach.store.pinned)))
    back(call(World.update(w, s = s), e, efi, args), x, pinnedBefore, tail, mach)

fn back(c: Called, x: Inst, pinnedBefore: List<Val>, tail: Bool, mach: Machine) -> Called
    ? "The caller resumed on the store the callee left, unpinned, with its memory 0 on top again: with the results, or with the exception the callee did not catch; a trap ends the run."
    s = Exec.swapTo(Store.update(c.w.s, pinned = pinnedBefore), Exec.maddr(x, 0))
    w = World.update(c.w, s = s)
    match c.exn
        Option.Some(ex) -> runOut(w, x, Exec.resumeThrow(x, Machine.update(mach, store = s), ex.tag, ex.vals))
        Option.None -> resumedWith(w, c.r, x, s, tail, mach)

fn resumedWith(w: World, r: Result<List<Val>, String>, x: Inst, s: Store, tail: Bool, mach: Machine) -> Called
    ? "Resumes with the results, or passes a trap on."
    match r
        Result.Err(e) -> Called(w = w, r = Result.Err(e), exn = Option.None)
        Result.Ok(vs) -> runOut(w, x, Exec.resume(x, Machine.update(mach, store = s), vs, tail))

verify call
    call(empty(), 0, 0, []).r => Result.Err("no instance 0")

verify runOut
    runOut(empty(), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Outcome.Trap("x", Exec.blankStore())).r => Result.Err("trap: x")

verify hostOut
    hostOut(empty(), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 0, [], false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("call to an undefined import")

verify imported
    imported(empty(), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Fn(code = Vector.fromList([]), targets = Vector.fromList([]), defaults = Vector.fromList([]), params = 0, results = 0, imported = true, mod = "M", name = "f", ty = 0, cap = 1), [], false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("unknown import M.f")

verify importedFrom
    importedFrom(empty(), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 5, Fn(code = Vector.fromList([]), targets = Vector.fromList([]), defaults = Vector.fromList([]), params = 0, results = 0, imported = true, mod = "M", name = "f", ty = 0, cap = 1), [], false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("unknown import M.f")

verify across
    across(empty(), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), 3, 0, [], false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("no instance 3")

verify back
    back(Called(w = empty(), r = Result.Err("x"), exn = Option.None), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), [], false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("x")

verify resumedWith
    resumedWith(empty(), Result.Err("x"), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Exec.blankStore(), false, Machine(frame = Frame(code = Vector.fromList([]), pc = 0, locals = Vector.fromList([]), stack = Vector.fromList([]), sp = 0, targets = Vector.fromList([]), arity = 0, depth = 0), calls = [], store = Exec.blankStore())).r => Result.Err("x")

// ---- imports ----

fn importsOk(w: World, m: Module, is: List<Import>) -> Result<Unit, String>
    ? "Every import names something its provider exports, of the same kind and a matching type: spectest's own objects, or a registered instance's exports."
    match is
        [] -> Result.Ok(Unit)
        [i, ..rest] -> importsNext(w, m, importOk(w, m, i), rest)

verify importsOk
    importsOk(empty(), Ast.emptyModule(), []) => Result.Ok(Unit)

fn importsNext(w: World, m: Module, r: Result<Unit, String>, rest: List<Import>) -> Result<Unit, String>
    ? "Goes on after one import."
    ok = r?
    importsOk(w, m, rest)

verify importsNext
    importsNext(empty(), Ast.emptyModule(), Result.Err("x"), []) => Result.Err("x")

fn importOk(w: World, m: Module, i: Import) -> Result<Unit, String>
    ? "One import checked against its provider."
    match i.mod == "spectest"
        true -> spectestOk(m, i)
        false -> match Map.get(w.named, i.mod)
            Option.None -> Result.Err("unknown import {i.mod}.{i.name}")
            Option.Some(e) -> fromInstance(w, m, i, Map.get(w.insts, e))

verify importOk
    importOk(empty(), Ast.emptyModule(), Import(mod = "M", name = "f", kind = 0, index = 0, lo = 0, hi = 0, hasMax = false)) => Result.Err("unknown import M.f")
    importOk(empty(), Ast.emptyModule(), Import(mod = "spectest", name = "nothing", kind = 0, index = 0, lo = 0, hi = 0, hasMax = false)) => Result.Err("unknown import spectest.nothing")

fn fromInstance(w: World, m: Module, i: Import, inst: Option<Inst>) -> Result<Unit, String>
    ? "An import from a registered instance: the export must exist and be of the import's kind and type."
    match inst
        Option.None -> Result.Err("unknown import {i.mod}.{i.name}")
        Option.Some(ins) -> match anyExport(ins.m.exports, i.name)
            Option.None -> Result.Err("unknown import {i.mod}.{i.name}")
            Option.Some(ex) -> match ex.kind == i.kind
                false -> Result.Err("incompatible import type")
                true -> compatible(kindMatches(m, i, ins, w.s, ex.index))

verify fromInstance
    fromInstance(empty(), Ast.emptyModule(), Import(mod = "M", name = "f", kind = 0, index = 0, lo = 0, hi = 0, hasMax = false), Option.None) => Result.Err("unknown import M.f")

fn compatible(ok: Bool) -> Result<Unit, String>
    ? "The import's type check."
    match ok
        true -> Result.Ok(Unit)
        false -> Result.Err("incompatible import type")

verify compatible
    compatible(false) => Result.Err("incompatible import type")

fn anyExport(es: List<Export>, name: String) -> Option<Export>
    ? "The export named name, of any kind."
    match es
        [] -> Option.None
        [e, ..rest] -> match e.name == name
            true -> Option.Some(e)
            false -> anyExport(rest, name)

verify anyExport
    anyExport([Export(name = "a", kind = 2, index = 0)], "a") => Option.Some(Export(name = "a", kind = 2, index = 0))

fn kindMatches(m: Module, i: Import, ins: Inst, s: Store, k: Int) -> Bool
    ? "Whether export k of the instance fits the import: equal function and tag types, a table or memory at least as large and growing no further than the import allows, a global of the same type and mutability."
    em = ins.m
    match i.kind
        0 -> Types.subX(em, funcTypeOf(em, k), m, funcTypeOf(m, i.index), 8)
        1 -> Bool.and(Bool.and(Types.valEq(m, tableType(m, i.index), em, tableType(em, k), 8), Ast.tableIs64(m, i.index) == Ast.tableIs64(em, k)), limitsFit(i, Vector.len(Exec.table(s, Exec.taddr(ins, k))), Ast.tableMax(em, k), tableHasMax(em, k)))
        2 -> Bool.and(Ast.memIs64(m, i.index) == Ast.memIs64(em, k), limitsFit(i, Exec.memState(s, Exec.maddr(ins, k)).pages, memMaxOf(em, k), memHasMax(em, k)))
        3 -> globalsMatch(m, globalOf(m, i.index), em, globalOf(em, k))
        _ -> Types.compEq(m, Ast.tagType(m, i.index), em, Ast.tagType(em, k), 8)

verify kindMatches
    kindMatches(Ast.emptyModule(), Import(mod = "M", name = "t", kind = 4, index = 0, lo = 0, hi = 0, hasMax = false), Inst(m = Ast.emptyModule(), fns = Vector.fromList([]), base = 0, tags = Vector.fromList([]), ga = Vector.fromList([]), ta = Vector.fromList([]), ma = Vector.fromList([]), ea = Vector.fromList([]), da = Vector.fromList([]), flat = true), Exec.blankStore(), 0) => false

fn limitsFit(i: Import, size: Int, max: Int, hasMax: Bool) -> Bool
    ? "A provided table or memory of this size and maximum fits the import's declared limits."
    Bool.and(i.lo <= size, Bool.or(Bool.not(i.hasMax), Bool.and(hasMax, max <= i.hi)))

verify limitsFit
    limitsFit(Import(mod = "M", name = "m", kind = 2, index = 0, lo = 2, hi = 0, hasMax = false), 1, 2, true) => false
    limitsFit(Import(mod = "M", name = "m", kind = 2, index = 0, lo = 1, hi = 3, hasMax = true), 1, 2, true) => true

fn funcTypeOf(m: Module, f: Int) -> Int
    ? "The type index of function f."
    match Vector.get(m.funcs, f)
        Option.Some(Func.Imported(_, _, t)) -> t
        Option.Some(Func.Local(t, _, _)) -> t
        Option.None -> -1

verify funcTypeOf
    funcTypeOf(Ast.emptyModule(), 0) => -1

fn tableType(m: Module, t: Int) -> ValType
    ? "The element type of table t."
    match List.drop(m.tables, t)
        [v, .._] -> v
        [] -> ValType.I32

verify tableType
    tableType(Ast.emptyModule(), 0) => ValType.I32

fn tableHasMax(m: Module, t: Int) -> Bool
    ? "Whether table t declares a maximum."
    Ast.tableMax(m, t) < 4294967296

verify tableHasMax
    tableHasMax(Ast.emptyModule(), 0) => false

fn memMaxOf(m: Module, k: Int) -> Int
    ? "The maximum of memory k in pages."
    match k == 0
        true -> m.memMax
        false -> match List.drop(m.moreMems, k - 1)
            [t, .._] -> t.max
            [] -> 0

verify memMaxOf
    memMaxOf(Ast.emptyModule(), 0) => 65536

fn memHasMax(m: Module, k: Int) -> Bool
    ? "Whether memory k declares a maximum; one at the largest size there is counts as none."
    match Ast.memIs64(m, k)
        true -> memMaxOf(m, k) < 281474976710656
        false -> memMaxOf(m, k) < 65536

verify memHasMax
    memHasMax(Ast.emptyModule(), 0) => false

fn globalOf(m: Module, g: Int) -> Global
    ? "Global g."
    Option.withDefault(Vector.get(m.globals, g), Global(ty = ValType.I32, init = Vector.fromList([]), from = "", mut = false))

verify globalOf
    globalOf(Ast.emptyModule(), 0).mut => false

fn globalsMatch(m: Module, a: Global, em: Module, b: Global) -> Bool
    ? "Same mutability; a mutable global of the same type, an immutable one of a subtype of the import's."
    match a.mut == b.mut
        false -> false
        true -> match a.mut
            true -> Types.valEq(m, a.ty, em, b.ty, 8)
            false -> Types.valSubX(em, b.ty, m, a.ty)

verify globalsMatch
    globalsMatch(Ast.emptyModule(), Global(ty = ValType.I32, init = Vector.fromList([]), from = "", mut = true), Ast.emptyModule(), Global(ty = ValType.I32, init = Vector.fromList([]), from = "", mut = false)) => false

fn spectestOk(m: Module, i: Import) -> Result<Unit, String>
    ? "An import from spectest: its print functions, four immutable globals, a table of 10 to 20 function references and a memory of 1 to 2 pages."
    match spectestFits(m, i)
        Option.None -> Result.Err("unknown import {i.mod}.{i.name}")
        Option.Some(ok) -> compatible(ok)

verify spectestOk
    spectestOk(Ast.emptyModule(), Import(mod = "spectest", name = "memory", kind = 2, index = 0, lo = 2, hi = 0, hasMax = false)) => Result.Err("incompatible import type")

fn spectestFits(m: Module, i: Import) -> Option<Bool>
    ? "None when spectest has nothing of that name and kind... or of that name at all; else whether it fits."
    match i.name
        "print" -> kindIs(i, 0, sigIs(m, i, []))
        "print_i32" -> kindIs(i, 0, sigIs(m, i, [ValType.I32]))
        "print_i64" -> kindIs(i, 0, sigIs(m, i, [ValType.I64]))
        "print_f32" -> kindIs(i, 0, sigIs(m, i, [ValType.F32]))
        "print_f64" -> kindIs(i, 0, sigIs(m, i, [ValType.F64]))
        "print_i32_f32" -> kindIs(i, 0, sigIs(m, i, [ValType.I32, ValType.F32]))
        "print_f64_f64" -> kindIs(i, 0, sigIs(m, i, [ValType.F64, ValType.F64]))
        "global_i32" -> kindIs(i, 3, globalIs(m, i, ValType.I32))
        "global_i64" -> kindIs(i, 3, globalIs(m, i, ValType.I64))
        "global_f32" -> kindIs(i, 3, globalIs(m, i, ValType.F32))
        "global_f64" -> kindIs(i, 3, globalIs(m, i, ValType.F64))
        "table" -> kindIs(i, 1, Bool.and(Bool.and(tableType(m, i.index) == ValType.Ref(true, -16), Bool.not(Ast.tableIs64(m, i.index))), limitsFit(i, 10, 20, true)))
        "table64" -> kindIs(i, 1, Bool.and(Bool.and(tableType(m, i.index) == ValType.Ref(true, -16), Ast.tableIs64(m, i.index)), limitsFit(i, 10, 20, true)))
        "memory" -> kindIs(i, 2, Bool.and(Bool.not(Ast.memIs64(m, i.index)), limitsFit(i, 1, 2, true)))
        _ -> Option.None

verify spectestFits
    spectestFits(Ast.emptyModule(), Import(mod = "spectest", name = "memory", kind = 2, index = 0, lo = 1, hi = 2, hasMax = true)) => Option.Some(true)

fn kindIs(i: Import, kind: Int, ok: Bool) -> Option<Bool>
    ? "ok when the import is of the provided kind; a kind mismatch is incompatible."
    Option.Some(Bool.and(i.kind == kind, ok))

verify kindIs
    kindIs(Import(mod = "spectest", name = "memory", kind = 1, index = 0, lo = 0, hi = 0, hasMax = false), 2, true) => Option.Some(false)

fn sigIs(m: Module, i: Import, params: List<ValType>) -> Bool
    ? "Whether imported function i takes params and returns nothing."
    match Ast.funcType(m, funcTypeOf(m, i.index))
        Comp.FuncT(ps, rs) -> Bool.and(ps == params, List.len(rs) == 0)
        _ -> false

verify sigIs
    sigIs(Ast.emptyModule(), Import(mod = "spectest", name = "print", kind = 0, index = 0, lo = 0, hi = 0, hasMax = false), []) => true

fn globalIs(m: Module, i: Import, t: ValType) -> Bool
    ? "Whether imported global i is an immutable global of type t."
    g = globalOf(m, i.index)
    Bool.and(Bool.not(g.mut), g.ty == t)

verify globalIs
    globalIs(Ast.emptyModule(), Import(mod = "spectest", name = "global_i32", kind = 3, index = 0, lo = 0, hi = 0, hasMax = false), ValType.I32) => true

fn exportOf(m: Module, name: String, kind: Int) -> Option<Int>
    ? "The index of the export of this kind named name."
    findExport(m.exports, name, kind)

verify exportOf
    exportOf(Module.update(Ast.emptyModule(), exports = [Export(name = "m", kind = 2, index = 0)]), "m", 2) => Option.Some(0)
    exportOf(Ast.emptyModule(), "m", 2) => Option.None

fn findExport(es: List<Export>, name: String, kind: Int) -> Option<Int>
    ? "Searches the exports."
    match es
        [] -> Option.None
        [e, ..rest] -> match Bool.and(e.name == name, e.kind == kind)
            true -> Option.Some(e.index)
            false -> findExport(rest, name, kind)

verify findExport
    findExport([Export(name = "m", kind = 0, index = 1)], "m", 2) => Option.None

fn tagIds(w: World, m: Module, base: Int, j: Int, acc: List<Int>) -> List<Int>
    ? "The identity of each of m's tags: an imported one's is its exporter's, a defined one's is base plus its index."
    match j >= List.len(m.tags)
        true -> List.reverse(acc)
        false -> tagIds(w, m, base, j + 1, List.prepend(tagIdOf(w, importOfTag(m.imports, j), base + j), acc))

verify tagIds
    tagIds(empty(), Module.update(Ast.emptyModule(), tags = [0, 0]), 10, 0, []) => [10, 11]

fn importOfTag(is: List<Import>, j: Int) -> Option<Import>
    ? "The import that brings tag j in, if it is imported."
    match is
        [] -> Option.None
        [i, ..rest] -> match Bool.and(i.kind == 4, i.index == j)
            true -> Option.Some(i)
            false -> importOfTag(rest, j)

verify importOfTag
    importOfTag([], 0) => Option.None

fn tagIdOf(w: World, imp: Option<Import>, own: Int) -> Int
    ? "An imported tag's identity at its exporter, or own."
    match imp
        Option.None -> own
        Option.Some(i) -> match Map.get(w.named, i.mod)
            Option.None -> own
            Option.Some(e) -> match Map.get(w.insts, e)
                Option.None -> own
                Option.Some(ins) -> match exportOf(ins.m, i.name, 4)
                    Option.None -> own
                    Option.Some(k) -> Exec.tagId(ins, k)

verify tagIdOf
    tagIdOf(empty(), Option.None, 5) => 5

