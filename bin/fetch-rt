#!/bin/sh
# Copies aver-rt from a commit of the Aver repository (default: the commit
# named in .aver-commit) into .aver-rt/, for bin/build.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
commit="${1:-$(cat "$root/.aver-commit")}"
rm -rf "$root/.aver-rt" && mkdir -p "$root/.aver-rt"
(cd "${AVER_REPO:-$root/../lumen-rs}" && git archive "$commit" aver-rt) | tar -x -C "$root/.aver-rt"
